<UserControl x:Class="XB2Midi.Views.SoloMappingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:XB2Midi.Views"
             mc:Ignorable="d"
             d:DesignHeight="600"
             d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header with instructions -->
        <Border Grid.Row="0"
                Background="#F0F0F0"
                Padding="10"
                Margin="0,0,0,10">
            <TextBlock TextWrapping="Wrap">
                <Bold>Solo Mode:</Bold> Play the controller like an instrument with dynamic pitch bend and velocity control.
            </TextBlock>
        </Border>

       <!-- Main content area -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <!-- Left column - Controller mapping visualization -->
            <Border Grid.Column="0"
                    BorderThickness="1"
                    BorderBrush="#CCCCCC"
                    Margin="5"
                    Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Key Configuration Controls (moved outside of TabControl) -->
                    <Grid Grid.Row="0" Margin="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="150"/>  <!-- Made wider for longer key names -->
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="90"/>
                        </Grid.ColumnDefinitions>

                        <!-- Key Selection -->
                        <TextBlock Grid.Column="0" Text="Key:" Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="1" x:Name="KeySelector" Margin="0,0,10,0" SelectionChanged="KeySelector_SelectionChanged">
                            <ComboBoxItem Content="Custom"/>
                            <!-- C Keys -->
                            <ComboBoxItem Content="C2"/>
                            <ComboBoxItem Content="C3"/>
                            <ComboBoxItem Content="C4" IsSelected="True"/>
                            <ComboBoxItem Content="C5"/>
                            <ComboBoxItem Content="C6"/>
                            <!-- C# Keys -->
                            <ComboBoxItem Content="C#/Db2"/>
                            <ComboBoxItem Content="C#/Db3"/>
                            <ComboBoxItem Content="C#/Db4"/>
                            <ComboBoxItem Content="C#/Db5"/>
                            <ComboBoxItem Content="C#/Db6"/>
                            <!-- Continue for all notes/octaves -->
                        </ComboBox>

                        <!-- Mode Selection -->
                        <TextBlock Grid.Column="2" Text="Mode:" Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="3" x:Name="ModeSelector" Margin="0,0,10,0" SelectionChanged="ModeSelector_SelectionChanged">
                            <ComboBoxItem Content="Major" IsSelected="True"/>
                            <ComboBoxItem Content="Minor"/>
                        </ComboBox>
                    </Grid>

                    <!-- Button Mappings Container -->
                    <StackPanel Grid.Row="1">
                        <!-- Face Buttons and D-Pad groups will go here -->
                        <!-- Face Buttons Group -->
                        <GroupBox Header="Face Buttons"
                                  Margin="0,5">
                            <Grid Margin="5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Header row with improved styling -->
                                <TextBlock Grid.Row="0"
                                           Grid.Column="0"
                                           Text="Button"
                                           FontWeight="Bold"
                                           Margin="5"
                                           Padding="3"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Grid.Row="0"
                                           Grid.Column="1"
                                           Text="Note"
                                           FontWeight="Bold"
                                           Margin="5"
                                           Padding="3"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Grid.Row="0"
                                           Grid.Column="2"
                                           Text="Ch"
                                           FontWeight="Bold"
                                           Margin="5"
                                           Padding="3"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Grid.Row="0"
                                           Grid.Column="3"
                                           Text="MIDI Device"
                                           FontWeight="Bold"
                                           Margin="5"
                                           Padding="3"
                                           HorizontalAlignment="Center"/>

                                <!-- Y Button -->
                                <Border Grid.Row="1"
                                        Grid.Column="0"
                                        Width="24"
                                        Height="24"
                                        CornerRadius="12"
                                        Background="#FFFFE200"
                                        Margin="5"
                                        BorderBrush="Black"
                                        BorderThickness="1">
                                    <TextBlock Text="Y"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Foreground="Black"/>
                                </Border>
                                <ComboBox Grid.Row="1"
                                          Grid.Column="1"
                                          x:Name="YButtonNoteCombo"
                                          Margin="5"
                                          Width="85"
                                          IsEnabled="False"/>
                                <ComboBox Grid.Row="1"
                                          Grid.Column="2"
                                          x:Name="YChannelCombo"
                                          Margin="5"
                                          Width="45"
                                          IsEnabled="False"/>
                                <ComboBox Grid.Row="1"
                                          Grid.Column="3"
                                          x:Name="YDeviceCombo"
                                          Margin="5"
                                          MinWidth="200"
                                          IsEnabled="False"/>

                                <!-- B Button -->
                                <Border Grid.Row="2"
                                        Grid.Column="0"
                                        Width="24"
                                        Height="24"
                                        CornerRadius="12"
                                        Background="#FFE50000"
                                        Margin="5"
                                        BorderBrush="Black"
                                        BorderThickness="1">
                                    <TextBlock Text="B"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Foreground="White"/>
                                </Border>
                                <ComboBox Grid.Row="2"
                                          Grid.Column="1"
                                          x:Name="BButtonNoteCombo"
                                          Margin="5"
                                          Width="85"
                                          IsEnabled="False"/>
                                <ComboBox Grid.Row="2"
                                          Grid.Column="2"
                                          x:Name="BChannelCombo"
                                          Margin="5"
                                          Width="45"
                                          IsEnabled="False"/>
                                <ComboBox Grid.Row="2"
                                          Grid.Column="3"
                                          x:Name="BDeviceCombo"
                                          Margin="5"
                                          MinWidth="200"
                                          IsEnabled="False"/>

                                <!-- A Button -->
                                <Border Grid.Row="3"
                                        Grid.Column="0"
                                        Width="24"
                                        Height="24"
                                        CornerRadius="12"
                                        Background="#FF00B300"
                                        Margin="5"
                                        BorderBrush="Black"
                                        BorderThickness="1">
                                    <TextBlock Text="A"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Foreground="White"/>
                                </Border>
                                <ComboBox Grid.Row="3"
                                          Grid.Column="1"
                                          x:Name="AButtonNoteCombo"
                                          Margin="5"
                                          Width="85"
                                          IsEnabled="False"/>
                                <ComboBox Grid.Row="3"
                                          Grid.Column="2"
                                          x:Name="AChannelCombo"
                                          Margin="5"
                                          Width="45"
                                          IsEnabled="False"/>
                                <ComboBox Grid.Row="3"
                                          Grid.Column="3"
                                          x:Name="ADeviceCombo"
                                          Margin="5"
                                          MinWidth="200"
                                          IsEnabled="False"/>

                                <!-- X Button -->
                                <Border Grid.Row="4"
                                        Grid.Column="0"
                                        Width="24"
                                        Height="24"
                                        CornerRadius="12"
                                        Background="#FF0085E5"
                                        Margin="5"
                                        BorderBrush="Black"
                                        BorderThickness="1">
                                    <TextBlock Text="X"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Foreground="White"/>
                                </Border>
                                <ComboBox Grid.Row="4"
                                          Grid.Column="1"
                                          x:Name="XButtonNoteCombo"
                                          Margin="5"
                                          Width="85"
                                          IsEnabled="False"/>
                                <ComboBox Grid.Row="4"
                                          Grid.Column="2"
                                          x:Name="XChannelCombo"
                                          Margin="5"
                                          Width="45"
                                          IsEnabled="False"/>
                                <ComboBox Grid.Row="4"
                                          Grid.Column="3"
                                          x:Name="XDeviceCombo"
                                          Margin="5"
                                          MinWidth="200"
                                          IsEnabled="False"/>
                            </Grid>
                        </GroupBox>

                        <!-- D-Pad -->
                        <GroupBox Header="D-Pad"
                                  Margin="0,5">
                            <Grid Margin="5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Header row with improved styling -->
                                <TextBlock Grid.Row="0"
                                           Grid.Column="0"
                                           Text="Button"
                                           FontWeight="Bold"
                                           Margin="5"
                                           Padding="3"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Grid.Row="0"
                                           Grid.Column="1"
                                           Text="Note"
                                           FontWeight="Bold"
                                           Margin="5"
                                           Padding="3"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Grid.Row="0"
                                           Grid.Column="2"
                                           Text="Ch"
                                           FontWeight="Bold"
                                           Margin="5"
                                           Padding="3"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Grid.Row="0"
                                           Grid.Column="3"
                                           Text="MIDI Device"
                                           FontWeight="Bold"
                                           Margin="5"
                                           Padding="3"
                                           HorizontalAlignment="Center"/>

                                <!-- DPad Up -->
                                <TextBlock Grid.Row="1"
                                           Grid.Column="0"
                                           Text="Up:"
                                           Margin="5"/>
                                <ComboBox Grid.Row="1"
                                          Grid.Column="1"
                                          x:Name="DPadUpNoteCombo"
                                          Margin="5"
                                          Width="85"
                                          IsEnabled="False"/>
                                <ComboBox Grid.Row="1"
                                          Grid.Column="2"
                                          x:Name="DPadUpChannelCombo"
                                          Margin="5"
                                          Width="45"
                                          IsEnabled="False"/>
                                <ComboBox Grid.Row="1"
                                          Grid.Column="3"
                                          x:Name="DPadUpDeviceCombo"
                                          Margin="5"
                                          MinWidth="200"
                                          IsEnabled="False"/>

                                <!-- DPad Right -->
                                <TextBlock Grid.Row="2"
                                           Grid.Column="0"
                                           Text="Right:"
                                           Margin="5"/>
                                <ComboBox Grid.Row="2"
                                          Grid.Column="1"
                                          x:Name="DPadRightNoteCombo"
                                          Margin="5"
                                          Width="85"
                                          IsEnabled="False"/>
                                <ComboBox Grid.Row="2"
                                          Grid.Column="2"
                                          x:Name="DPadRightChannelCombo"
                                          Margin="5"
                                          Width="45"
                                          IsEnabled="False"/>
                                <ComboBox Grid.Row="2"
                                          Grid.Column="3"
                                          x:Name="DPadRightDeviceCombo"
                                          Margin="5"
                                          MinWidth="200"
                                          IsEnabled="False"/>

                                <!-- DPad Down -->
                                <TextBlock Grid.Row="3"
                                           Grid.Column="0"
                                           Text="Down:"
                                           Margin="5"/>
                                <ComboBox Grid.Row="3"
                                          Grid.Column="1"
                                          x:Name="DPadDownNoteCombo"
                                          Margin="5"
                                          Width="85"
                                          IsEnabled="False"/>
                                <ComboBox Grid.Row="3"
                                          Grid.Column="2"
                                          x:Name="DPadDownChannelCombo"
                                          Margin="5"
                                          Width="45"
                                          IsEnabled="False"/>
                                <ComboBox Grid.Row="3"
                                          Grid.Column="3"
                                          x:Name="DPadDownDeviceCombo"
                                          Margin="5"
                                          MinWidth="200"
                                          IsEnabled="False"/>

                                <!-- DPad Left -->
                                <TextBlock Grid.Row="4"
                                           Grid.Column="0"
                                           Text="Left:"
                                           Margin="5"/>
                                <ComboBox Grid.Row="4"
                                          Grid.Column="1"
                                          x:Name="DPadLeftNoteCombo"
                                          Margin="5"
                                          Width="85"
                                          IsEnabled="False"/>
                                <ComboBox Grid.Row="4"
                                          Grid.Column="2"
                                          x:Name="DPadLeftChannelCombo"
                                          Margin="5"
                                          Width="45"
                                          IsEnabled="False"/>
                                <ComboBox Grid.Row="4"
                                          Grid.Column="3"
                                          x:Name="DPadLeftDeviceCombo"
                                          Margin="5"
                                          MinWidth="200"
                                          IsEnabled="False"/>
                            </Grid>
                        </GroupBox>
                    </StackPanel>

                    <!-- Control buttons -->
                    <StackPanel Grid.Row="2"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Margin="0,10,0,0">
                        <Button Content="Reset"
                                x:Name="ResetSoloMappingsButton"
                                Margin="5"
                                Padding="10,5"
                                IsEnabled="False"/>
                        <Button Content="Rename"
                                x:Name="RenameSoloMappingsButton"
                                Margin="5"
                                Padding="10,5"
                                IsEnabled="False"/>
                        <Button Content="Load"
                                x:Name="LoadSoloMappingsButton"
                                Margin="5"
                                Padding="10,5"
                                IsEnabled="False"/>
                        <Button Content="Save"
                                x:Name="SaveSoloMappingsButton"
                                Margin="5"
                                Padding="10,5"
                                IsEnabled="False"/>
                    </StackPanel>

                    <!-- Activity Log Section -->
                    <GroupBox Grid.Row="3"
                              Header="Solo Activity"
                              Margin="0,10,0,0">
                        <ListBox x:Name="SoloActivityLog"
                                 Height="150"
                                 Margin="5"/>
                    </GroupBox>
                </Grid>
            </Border>

            <!-- Right column - Arpeggio configuration and settings -->
            <Border Grid.Column="1"
                    BorderThickness="1"
                    BorderBrush="#CCCCCC"
                    Margin="5"
                    Padding="10">
                    <Grid></Grid>
               </Border>
        </Grid>
    </Grid>
</UserControl>
