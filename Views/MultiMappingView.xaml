<UserControl x:Class="XB2Midi.Views.MultiMappingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:XB2Midi.Views"
             xmlns:viewmodels="clr-namespace:XB2Midi.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Header with description -->
        <Border Grid.Row="0" Background="#F0F0F0" Padding="10" Margin="0,0,0,10">
            <TextBlock TextWrapping="Wrap">
                <Bold>Multi Mode:</Bold> Assign multiple MIDI actions to a single controller input.
            </TextBlock>
        </Border>
        
        <!-- Main content area -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>
            
            <!-- Left side - Controls -->
            <Border Grid.Column="0" BorderThickness="1" BorderBrush="#CCCCCC" Margin="5" Padding="10">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Multi-Mapping Configuration" FontWeight="Bold" Margin="0,0,0,10"/>
                        
                        <!-- Input selection -->
                        <GroupBox Header="Controller Input" Margin="0,5,0,10">
                            <StackPanel Margin="5">
                                <ComboBox ItemsSource="{Binding ControllerInputs}" 
                                          SelectedItem="{Binding SelectedControllerInput}"
                                          Margin="0,5"/>
                            </StackPanel>
                        </GroupBox>
                        
                        <!-- MIDI configuration -->
                        <GroupBox Header="MIDI Configuration" Margin="0,5,0,10">
                            <StackPanel Margin="5">
                                <TextBlock Text="MIDI Type:" Margin="0,5,0,0"/>
                                <ComboBox SelectedItem="{Binding SelectedMidiType}" Margin="0,5">
                                    <ComboBoxItem Content="Note"/>
                                    <ComboBoxItem Content="Control Change"/>
                                    <ComboBoxItem Content="Pitch Bend"/>
                                </ComboBox>
                                <TextBlock Text="MIDI Channel:" Margin="0,5,0,0"/>
                                <TextBox Text="{Binding MidiChannel}" Margin="0,5"/>
                                <TextBlock Text="MIDI Value:" Margin="0,5,0,0"/>
                                <TextBox Text="{Binding MidiValue}" Margin="0,5" IsEnabled="{Binding IsMidiValueEnabled}"/>
                                <TextBlock Text="MIDI Device:" Margin="0,5,0,0"/>
                                <ComboBox ItemsSource="{Binding MidiDevices}" SelectedItem="{Binding SelectedDevice}" Margin="0,5"/>
                            </StackPanel>
                        </GroupBox>

                        <!-- Mappings for selected input -->
                        <GroupBox Header="Mappings for Selected Input" Margin="0,5,0,10">
                            <StackPanel>
                                <ListBox ItemsSource="{Binding SelectedInputMappings}" SelectedItem="{Binding SelectedMapping}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding DisplayType}" Margin="0,0,10,0"/>
                                                <TextBlock Text="{Binding DisplayValue}" Margin="0,0,10,0"/>
                                                <TextBlock Text="{Binding DeviceName}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                    <Button Content="Add Mapping" Command="{Binding AddMappingCommand}" Margin="0,0,5,0"/>
                                    <Button Content="Remove Selected" Command="{Binding DeleteMappingCommand}" CommandParameter="{Binding SelectedMapping}"/>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </Border>
            
            <!-- Right side - Preview -->
            <Border Grid.Column="1" BorderThickness="1" BorderBrush="#CCCCCC" Margin="5" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <TextBlock Grid.Row="0" Text="Multi-Mapping Preview" FontWeight="Bold" Margin="0,0,0,10"/>
                    
                    <!-- Placeholder for visualization -->
                    <Border Grid.Row="1" Background="#F8F8F8" BorderBrush="#DDDDDD" 
                           BorderThickness="1" Margin="0,0,0,10">
                        <TextBlock Text="Visualization will be available in future updates" 
                                  HorizontalAlignment="Center" VerticalAlignment="Center" 
                                  Foreground="#666666"/>
                    </Border>
                    
                    <!-- Activity log -->
                    <GroupBox Grid.Row="2" Header="Activity">
                        <ListBox x:Name="MultiModeActivityLog" Height="100" Margin="5"/>
                    </GroupBox>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
