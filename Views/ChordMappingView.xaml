                                            Padding="5,3"
                                            Click="ChordPreset_Click"
                                            HorizontalAlignment="Stretch"/>
                                </Grid>
                            </GroupBox>
                        </Grid>
                    </GroupBox>
                </Grid>
            </Border>
        </Grid>
    </Grid>

