<UserControl x:Class="XB2Midi.Views.ChordMappingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:XB2Midi.Views"
             mc:Ignorable="d"
             d:DesignHeight="600"
             d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header with instructions -->
        <Border Grid.Row="0"
                Background="#F0F0F0"
                Padding="10"
                Margin="0,0,0,10">
            <TextBlock TextWrapping="Wrap">
                            <Bold>Chord Mode:</Bold> Play roots, chords, and extensions using the controller.
            </TextBlock>
        </Border>

        <!-- Main content area -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <!-- Left column - Controller mapping visualization -->
            <Border Grid.Column="0"
                    BorderThickness="1"
                    BorderBrush="#CCCCCC"
                    Margin="5"
                    Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- NEW: Mapping Tabs Section -->
                    <TabControl Grid.Row="0"
                                x:Name="MappingTabsControl"
                                Margin="0,0,0,10"
                                SelectionChanged="MappingTabsControl_SelectionChanged">
                        <TabControl.Resources>
                            <Style TargetType="TabItem">
                                <Setter Property="MinWidth"
                                        Value="80"/>
                                <Setter Property="Padding"
                                        Value="8,3"/>
                            </Style>
                        </TabControl.Resources>
                        <!-- Tabs will be added here programmatically -->
                    </TabControl>

                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Face Buttons -->
                        <GroupBox Grid.Row="0"
                                  Header="Face Buttons"
                                  Margin="0,5">
                            <Grid Margin="5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Header row with improved styling -->
                                <TextBlock Grid.Row="0"
                                           Grid.Column="0"
                                           Text="Button"
                                           FontWeight="Bold"
                                           Margin="5"
                                           Padding="3"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Grid.Row="0"
                                           Grid.Column="1"
                                           Text="Note"
                                           FontWeight="Bold"
                                           Margin="5"
                                           Padding="3"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Grid.Row="0"
                                           Grid.Column="2"
                                           Text="Ch"
                                           FontWeight="Bold"
                                           Margin="5"
                                           Padding="3"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Grid.Row="0"
                                           Grid.Column="3"
                                           Text="MIDI Device"
                                           FontWeight="Bold"
                                           Margin="5"
                                           Padding="3"
                                           HorizontalAlignment="Center"/>

                                <!-- Y Button -->
                                <Border Grid.Row="1"
                                        Grid.Column="0"
                                        Width="24"
                                        Height="24"
                                        CornerRadius="12"
                                        Background="#FFFFE200"
                                        Margin="5"
                                        BorderBrush="Black"
                                        BorderThickness="1">
                                    <TextBlock Text="Y"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Foreground="Black"/>
                                </Border>
                                <ComboBox Grid.Row="1"
                                          Grid.Column="1"
                                          x:Name="YButtonNoteCombo"
                                          Margin="5"
                                          Width="85"/>
                                <ComboBox Grid.Row="1"
                                          Grid.Column="2"
                                          x:Name="YChannelCombo"
                                          Margin="5"
                                          Width="45"/>
                                <ComboBox Grid.Row="1"
                                          Grid.Column="3"
                                          x:Name="YDeviceCombo"
                                          Margin="5"
                                          MinWidth="200"/>

                                <!-- B Button -->
                                <Border Grid.Row="2"
                                        Grid.Column="0"
                                        Width="24"
                                        Height="24"
                                        CornerRadius="12"
                                        Background="#FFE50000"
                                        Margin="5"
                                        BorderBrush="Black"
                                        BorderThickness="1">
                                    <TextBlock Text="B"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Foreground="White"/>
                                </Border>
                                <ComboBox Grid.Row="2"
                                          Grid.Column="1"
                                          x:Name="BButtonNoteCombo"
                                          Margin="5"
                                          Width="85"/>
                                <ComboBox Grid.Row="2"
                                          Grid.Column="2"
                                          x:Name="BChannelCombo"
                                          Margin="5"
                                          Width="45"/>
                                <ComboBox Grid.Row="2"
                                          Grid.Column="3"
                                          x:Name="BDeviceCombo"
                                          Margin="5"
                                          MinWidth="200"/>

                                <!-- X Button -->
                                <Border Grid.Row="3"
                                        Grid.Column="0"
                                        Width="24"
                                        Height="24"
                                        CornerRadius="12"
                                        Background="#FF0085E5"
                                        Margin="5"
                                        BorderBrush="Black"
                                        BorderThickness="1">
                                    <TextBlock Text="X"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Foreground="White"/>
                                </Border>
                                <ComboBox Grid.Row="3"
                                          Grid.Column="1"
                                          x:Name="XButtonNoteCombo"
                                          Margin="5"
                                          Width="85"/>
                                <ComboBox Grid.Row="3"
                                          Grid.Column="2"
                                          x:Name="XChannelCombo"
                                          Margin="5"
                                          Width="45"/>
                                <ComboBox Grid.Row="3"
                                          Grid.Column="3"
                                          x:Name="XDeviceCombo"
                                          Margin="5"
                                          MinWidth="200"/>

                                <!-- A Button -->
                                <Border Grid.Row="4"
                                        Grid.Column="0"
                                        Width="24"
                                        Height="24"
                                        CornerRadius="12"
                                        Background="#FF00B300"
                                        Margin="5"
                                        BorderBrush="Black"
                                        BorderThickness="1">
                                    <TextBlock Text="A"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Foreground="White"/>
                                </Border>
                                <ComboBox Grid.Row="4"
                                          Grid.Column="1"
                                          x:Name="AButtonNoteCombo"
                                          Margin="5"
                                          Width="85"/>
                                <ComboBox Grid.Row="4"
                                          Grid.Column="2"
                                          x:Name="AChannelCombo"
                                          Margin="5"
                                          Width="45"/>
                                <ComboBox Grid.Row="4"
                                          Grid.Column="3"
                                          x:Name="ADeviceCombo"
                                          Margin="5"
                                          MinWidth="200"/>
                            </Grid>
                        </GroupBox>

                        <!-- D-Pad -->
                        <GroupBox Grid.Row="1"
                                  Header="D-Pad"
                                  Margin="0,5">
                            <Grid Margin="5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Header row with improved styling -->
                                <TextBlock Grid.Row="0"
                                           Grid.Column="0"
                                           Text="Button"
                                           FontWeight="Bold"
                                           Margin="5"
                                           Padding="3"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Grid.Row="0"
                                           Grid.Column="1"
                                           Text="Note"
                                           FontWeight="Bold"
                                           Margin="5"
                                           Padding="3"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Grid.Row="0"
                                           Grid.Column="2"
                                           Text="Ch"
                                           FontWeight="Bold"
                                           Margin="5"
                                           Padding="3"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Grid.Row="0"
                                           Grid.Column="3"
                                           Text="MIDI Device"
                                           FontWeight="Bold"
                                           Margin="5"
                                           Padding="3"
                                           HorizontalAlignment="Center"/>

                                <!-- DPad Up -->
                                <TextBlock Grid.Row="1"
                                           Grid.Column="0"
                                           Text="Up:"
                                           Margin="5"/>
                                <ComboBox Grid.Row="1"
                                          Grid.Column="1"
                                          x:Name="DPadUpNoteCombo"
                                          Margin="5"
                                          Width="85"/>
                                <ComboBox Grid.Row="1"
                                          Grid.Column="2"
                                          x:Name="DPadUpChannelCombo"
                                          Margin="5"
                                          Width="45"/>
                                <ComboBox Grid.Row="1"
                                          Grid.Column="3"
                                          x:Name="DPadUpDeviceCombo"
                                          Margin="5"
                                          MinWidth="200"/>

                                <!-- DPad Right -->
                                <TextBlock Grid.Row="2"
                                           Grid.Column="0"
                                           Text="Right:"
                                           Margin="5"/>
                                <ComboBox Grid.Row="2"
                                          Grid.Column="1"
                                          x:Name="DPadRightNoteCombo"
                                          Margin="5"
                                          Width="85"/>
                                <ComboBox Grid.Row="2"
                                          Grid.Column="2"
                                          x:Name="DPadRightChannelCombo"
                                          Margin="5"
                                          Width="45"/>
                                <ComboBox Grid.Row="2"
                                          Grid.Column="3"
                                          x:Name="DPadRightDeviceCombo"
                                          Margin="5"
                                          MinWidth="200"/>

                                <!-- DPad Down -->
                                <TextBlock Grid.Row="3"
                                           Grid.Column="0"
                                           Text="Down:"
                                           Margin="5"/>
                                <ComboBox Grid.Row="3"
                                          Grid.Column="1"
                                          x:Name="DPadDownNoteCombo"
                                          Margin="5"
                                          Width="85"/>
                                <ComboBox Grid.Row="3"
                                          Grid.Column="2"
                                          x:Name="DPadDownChannelCombo"
                                          Margin="5"
                                          Width="45"/>
                                <ComboBox Grid.Row="3"
                                          Grid.Column="3"
                                          x:Name="DPadDownDeviceCombo"
                                          Margin="5"
                                          MinWidth="200"/>

                                <!-- DPad Left -->
                                <TextBlock Grid.Row="4"
                                           Grid.Column="0"
                                           Text="Left:"
                                           Margin="5"/>
                                <ComboBox Grid.Row="4"
                                          Grid.Column="1"
                                          x:Name="DPadLeftNoteCombo"
                                          Margin="5"
                                          Width="85"/>
                                <ComboBox Grid.Row="4"
                                          Grid.Column="2"
                                          x:Name="DPadLeftChannelCombo"
                                          Margin="5"
                                          Width="45"/>
                                <ComboBox Grid.Row="4"
                                          Grid.Column="3"
                                          x:Name="DPadLeftDeviceCombo"
                                          Margin="5"
                                          MinWidth="200"/>
                            </Grid>
                        </GroupBox>
                    </Grid>

                    <!-- Moved buttons from footer to here -->
                    <StackPanel Grid.Row="2"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Margin="0,10,0,0">
                        <Button Content="Reset"
                                x:Name="ResetChordMappingsButton"
                                Margin="5"
                                Padding="10,5"
                                Click="ResetChordMappings_Click"/>
                        <Button Content="Rename"
                                x:Name="RenameChordMappingsButton"
                                Margin="5"
                                Padding="10,5"
                                Click="RenameChordMappings_Click"/>
                        <Button Content="Load"
                                x:Name="LoadChordMappingsButton"
                                Margin="5"
                                Padding="10,5"
                                Click="LoadChordMappings_Click"/>
                        <Button Content="Save"
                                x:Name="SaveChordMappingsButton"
                                Margin="5"
                                Padding="10,5"
                                Click="SaveChordMappings_Click"/>
                    </StackPanel>

                    <!-- Moved Chord Activity Log Section to left column -->
                    <GroupBox Grid.Row="3"
                              Header="Chord Activity"
                              Margin="0,10,0,0">
                        <ListBox x:Name="ChordActivityLog"
                                 Height="150"
                                 Margin="5"/>
                    </GroupBox>
                </Grid>
            </Border>

            <!-- Right column - Chord reference and sample chord section -->
            <Border Grid.Column="1"
                    BorderThickness="1"
                    BorderBrush="#CCCCCC"
                    Margin="5"
                    Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Chord Type Reference -->
                    <GroupBox Grid.Row="0"
                              Header="Chord Mode Controls Reference"
                              Margin="0,5">
                        <Grid Margin="5">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Chord type reference (left column) -->
                            <GroupBox Grid.Row="0"
                                      Grid.Column="0"
                                      Header="Chord Types"
                                      Margin="3"
                                      BorderBrush="#FFAAAAAA">
                                <Grid Margin="3">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Row="0"
                                               Grid.Column="0"
                                               Text="No Bumpers:"
                                               Margin="5"
                                               FontWeight="Bold"/>
                                    <TextBlock Grid.Row="0"
                                               Grid.Column="1"
                                               Text="Root Note Only"
                                               Margin="5"/>

                                    <TextBlock Grid.Row="1"
                                               Grid.Column="0"
                                               Text="Left Bumper (LB):"
                                               Margin="5"
                                               FontWeight="Bold"/>
                                    <TextBlock Grid.Row="1"
                                               Grid.Column="1"
                                               Text="Minor Triad (1-b3-5)"
                                               Margin="5"/>

                                    <TextBlock Grid.Row="2"
                                               Grid.Column="0"
                                               Text="Right Bumper (RB):"
                                               Margin="5"
                                               FontWeight="Bold"/>
                                    <TextBlock Grid.Row="2"
                                               Grid.Column="1"
                                               Text="Major Triad (1-3-5)"
                                               Margin="5"/>

                                    <TextBlock Grid.Row="3"
                                               Grid.Column="0"
                                               Text="Double-Tap LB:"
                                               Margin="5"
                                               FontWeight="Bold"/>
                                    <TextBlock Grid.Row="3"
                                               Grid.Column="1"
                                               Text="Minor 7th Chord (1-b3-5-b7)"
                                               Margin="5"/>

                                    <TextBlock Grid.Row="4"
                                               Grid.Column="0"
                                               Text="Double-Tap RB:"
                                               Margin="5"
                                               FontWeight="Bold"/>
                                    <TextBlock Grid.Row="4"
                                               Grid.Column="1"
                                               Text="Major 7th Chord (1-3-5-7)"
                                               Margin="5"/>

                                    <TextBlock Grid.Row="5"
                                               Grid.Column="0"
                                               Text="Triple-Tap LB:"
                                               Margin="5"
                                               FontWeight="Bold"/>
                                    <TextBlock Grid.Row="5"
                                               Grid.Column="1"
                                               Text="Minor 9th Chord (1-b3-5-b7-9)"
                                               Margin="5"/>

                                    <TextBlock Grid.Row="6"
                                               Grid.Column="0"
                                               Text="Triple-Tap RB:"
                                               Margin="5"
                                               FontWeight="Bold"/>
                                    <TextBlock Grid.Row="6"
                                               Grid.Column="1"
                                               Text="Major 9th Chord (1-3-5-7-9)"
                                               Margin="5"/>

                                    <TextBlock Grid.Row="7"
                                               Grid.Column="0"
                                               Text="Both Bumpers:"
                                               Margin="5"
                                               FontWeight="Bold"/>
                                    <TextBlock Grid.Row="7"
                                               Grid.Column="1"
                                               Text="Diminished Triad (1-b3-b5)"
                                               Margin="5"/>
                                </Grid>
                            </GroupBox>

                            <!-- Modifiers reference (right column) -->
                            <GroupBox Grid.Row="0"
                                      Grid.Column="1"
                                      Header="Modifiers"
                                      Margin="3"
                                      BorderBrush="#FFAAAAAA">
                                <Grid Margin="3">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Row="0"
                                               Grid.Column="0"
                                               Text="Left Trigger:"
                                               Margin="5"
                                               FontWeight="Bold"/>
                                    <TextBlock Grid.Row="0"
                                               Grid.Column="1"
                                               Text="Control velocity (pressure-sensitive)"
                                               Margin="5"/>

                                    <TextBlock Grid.Row="1"
                                               Grid.Column="0"
                                               Text="Right Trigger:"
                                               Margin="5"
                                               FontWeight="Bold"/>
                                    <TextBlock Grid.Row="1"
                                               Grid.Column="1"
                                               Text="Sustain notes when buttons are released"
                                               Margin="5"/>

                                    <TextBlock Grid.Row="2"
                                               Grid.Column="0"
                                               Text="Left Joystick:"
                                               Margin="5"
                                               FontWeight="Bold"
                                               VerticalAlignment="Top"/>
                                    <StackPanel Grid.Row="2"
                                                Grid.Column="1"
                                                Margin="5">
                                        <TextBlock Text="Change chord inversions:"
                                                   TextWrapping="Wrap"/>
                                        <TextBlock Text="• Center: Root position"
                                                   Margin="10,2,0,0"
                                                   TextWrapping="Wrap"/>
                                        <TextBlock Text="• Up: 1st inversion"
                                                   Margin="10,2,0,0"
                                                   TextWrapping="Wrap"/>
                                        <TextBlock Text="• Right: 2nd inversion"
                                                   Margin="10,2,0,0"
                                                   TextWrapping="Wrap"/>
                                        <TextBlock Text="• Down: 3rd inversion (7th chords)"
                                                   Margin="10,2,0,0"
                                                   TextWrapping="Wrap"/>
                                        <TextBlock Text="• Left: 4th inversion (9th chords)"
                                                   Margin="10,2,0,0"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Grid>
                            </GroupBox>

                            <!-- Root note buttons (spanning both columns) -->
                            <GroupBox Grid.Row="1"
                                      Grid.Column="0"
                                      Grid.ColumnSpan="2"
                                      Header="Root Note Buttons"
                                      Margin="3"
                                      BorderBrush="#FFAAAAAA">
                                <Grid Margin="3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="Face Buttons:"
                                               Margin="5"
                                               FontWeight="Bold"/>
                                    <TextBlock Grid.Column="1"
                                               Text="A, B, X, Y select respective root notes"
                                               Margin="5"/>

                                    <TextBlock Grid.Column="2"
                                               Text="D-Pad:"
                                               Margin="5"
                                               FontWeight="Bold"/>
                                    <TextBlock Grid.Column="3"
                                               Text="Up, Right, Down, Left select respective root notes"
                                               Margin="5"/>
                                </Grid>
                            </GroupBox>
                        </Grid>
                    </GroupBox>

                    <!-- Test Section - Redesigned with individual note toggles and optional root -->
                    <GroupBox Grid.Row="1"
                              Header="Sample Chord"
                              Margin="0,5">
                        <Grid Margin="5">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Root note selection and play button in top row -->
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0"
                                            Orientation="Horizontal">
                                    <TextBlock Text="Root:"
                                               Margin="5,0,5,0"
                                               VerticalAlignment="Center"/>
                                    <ComboBox x:Name="TestChordRootCombo"
                                              Width="70"
                                              Margin="0,5,5,5"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal">
                                    <TextBlock Text="Inversion:"
                                               Margin="5,0,5,0"
                                               VerticalAlignment="Center"/>
                                    <ComboBox x:Name="ChordInversionCombo"
                                              Width="110"
                                              Margin="0,5,5,5"/>
                                </StackPanel>

                                <Button Grid.Column="3"
                                        x:Name="PlayChordButton"
                                        Content="Play Chord"
                                        Width="110"
                                        Height="30"
                                        Padding="5,3"
                                        Margin="5,5,5,5"
                                        Background="#FFD5F7D5"
                                        FontWeight="SemiBold"
                                        Click="PlayCustomChord_Click"/>

                                <Button Grid.Column="4"
                                        x:Name="ClearChordButton"
                                        Content="Clear"
                                        Width="70"
                                        Height="30"
                                        Padding="5,3"
                                        Margin="5,5,5,5"
                                        Background="#FFFFF0D0"
                                        FontWeight="SemiBold"
                                        Command="{Binding ClearChordCommand}"/>
                            </Grid>

                            <!--#region NoteToggles-->
                            <!-- Note toggles in distinct groups -->
                            <GroupBox Grid.Row="1"
                                      Header="Notes"
                                      Margin="0,5,0,0"
                                      BorderBrush="#FFAAAAAA">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <!-- Evenly distribute columns -->
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Root Section -->
                                    <StackPanel Grid.Column="0"
                                                Orientation="Vertical"
                                                HorizontalAlignment="Center">
                                        <TextBlock Text="Root"
                                                   FontSize="11"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,2"/>
                                        <ToggleButton x:Name="RootToggle"
                                                      Content="Root"
                                                      Width="48"
                                                      Margin="3"
                                                      Padding="3,3"
                                                      IsChecked="{Binding RootToggleChecked, Mode=TwoWay}"
                                                      ToolTip="Root note"/>
                                    </StackPanel>

                                    <!-- Separator -->
                                    <Rectangle Grid.Column="1"
                                               Width="1"
                                               Fill="#FFCCCCCC"
                                               Margin="2,5"/>

                                    <!-- Third options -->
                                    <StackPanel Grid.Column="2"
                                                Orientation="Vertical"
                                                HorizontalAlignment="Center">
                                        <TextBlock Text="Third"
                                                   FontSize="11"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,2"/>
                                        <UniformGrid Columns="2">
                                            <ToggleButton x:Name="MajThirdToggle"
                                                          Content="3"
                                                          Width="40"
                                                          Margin="3"
                                                          Padding="3,3"
                                                          IsChecked="{Binding MajThirdToggleChecked, Mode=TwoWay}"
                                                          ToolTip="Major third (4 semitones)"/>
                                            <ToggleButton x:Name="MinThirdToggle"
                                                          Content="♭3"
                                                          Width="40"
                                                          Margin="3"
                                                          Padding="3,3"
                                                          IsChecked="{Binding MinThirdToggleChecked, Mode=TwoWay}"
                                                          ToolTip="Minor third (3 semitones)"/>
                                        </UniformGrid>
                                    </StackPanel>

                                    <!-- Separator -->
                                    <Rectangle Grid.Column="3"
                                               Width="1"
                                               Fill="#FFCCCCCC"
                                               Margin="2,5"/>

                                    <!-- Fifth options -->
                                    <StackPanel Grid.Column="4"
                                                Orientation="Vertical"
                                                HorizontalAlignment="Center">
                                        <TextBlock Text="Fifth"
                                                   FontSize="11"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,2"/>
                                        <UniformGrid Columns="2">
                                            <ToggleButton x:Name="FifthToggle"
                                                          Content="5"
                                                          Width="40"
                                                          Margin="3"
                                                          Padding="3,3"
                                                          IsChecked="{Binding FifthToggleChecked, Mode=TwoWay}"
                                                          ToolTip="Perfect fifth (7 semitones)"/>
                                            <ToggleButton x:Name="FlatFifthToggle"
                                                          Content="♭5"
                                                          Width="40"
                                                          Margin="3"
                                                          Padding="3,3"
                                                          IsChecked="{Binding FlatFifthToggleChecked, Mode=TwoWay}"
                                                          ToolTip="Diminished fifth (6 semitones)"/>
                                        </UniformGrid>
                                    </StackPanel>

                                    <!-- Separator -->
                                    <Rectangle Grid.Column="5"
                                               Width="1"
                                               Fill="#FFCCCCCC"
                                               Margin="2,5"/>

                                    <!-- Extensions container -->
                                    <StackPanel Grid.Column="6"
                                                Orientation="Vertical"
                                                HorizontalAlignment="Center">
                                        <TextBlock Text="Extensions"
                                                   FontSize="11"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,2"/>
                                        <UniformGrid Columns="3"
                                                     Rows="2">
                                            <ToggleButton x:Name="SixthToggle"
                                                    Content="6"
                                                    Width="35"
                                                    Margin="2"
                                                    Padding="2,2"
                                                          IsChecked="{Binding SixthToggleChecked, Mode=TwoWay}"
                                                          ToolTip="Major sixth (9 semitones)"/>
                                            <ToggleButton x:Name="DomSeventhToggle"
                                                    Content="♭7"
                                                    Width="35"
                                                    Margin="2"
                                                    Padding="2,2"
                                                          IsChecked="{Binding DomSeventhToggleChecked, Mode=TwoWay}"
                                                          ToolTip="Dominant seventh (10 semitones)"/>
                                            <ToggleButton x:Name="MajSeventhToggle"
                                                    Content="7"
                                                    Width="35"
                                                    Margin="2"
                                                    Padding="2,2"
                                                          IsChecked="{Binding MajSeventhToggleChecked, Mode=TwoWay}"
                                                          ToolTip="Major seventh (11 semitones)"/>
                                            <ToggleButton x:Name="NinthToggle"
                                                    Content="9"
                                                    Width="35"
                                                    Margin="2"
                                                    Padding="2,2"
                                                          IsChecked="{Binding NinthToggleChecked, Mode=TwoWay}"
                                                          ToolTip="Major ninth (14 semitones)"/>
                                            <ToggleButton x:Name="FlatNinthToggle"
                                                    Content="♭9"
                                                    Width="35"
                                                    Margin="2"
                                                    Padding="2,2"
                                                          IsChecked="{Binding FlatNinthToggleChecked, Mode=TwoWay}"
                                                          ToolTip="Flat ninth (13 semitones)"/>
                                            <!-- Empty space for alignment -->
                                            <Border Width="35"
                                                    Margin="2"
                                                    Background="Transparent"/>
                                        </UniformGrid>
                                    </StackPanel>
                                </Grid>
                            </GroupBox>
                            <!--#endregion Note Toggles-->


                            <!-- Preset buttons in a single row with even distribution -->
                            <GroupBox Grid.Row="2"
                                      Header="Presets"
                                      Margin="0,5,0,0"
                                      BorderBrush="#FFAAAAAA">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Button Grid.Column="0"
                                            Content="Major"
                                            Margin="2"
                                            Padding="5,3"
                                            Click="ChordPreset_Click"
                                            HorizontalAlignment="Stretch"/>
                                    <Button Grid.Column="1"
                                            Content="Minor"
