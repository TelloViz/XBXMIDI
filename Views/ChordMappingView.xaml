<UserControl x:Class="XB2Midi.Views.ChordMappingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:XB2Midi.Views"
             mc:Ignorable="d"
             d:DesignHeight="600"
             d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header with instructions -->
        <Border Grid.Row="0"
                Background="#F0F0F0"
                Padding="10"
                Margin="0,0,0,10">
            <TextBlock TextWrapping="Wrap">
                            <Bold>Chord Mode:</Bold> Play roots, chords, and extensions using the controller.
            </TextBlock>
        </Border>

        <!-- Main content area -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <!-- Left column - Controller mapping visualization -->
            <Border Grid.Column="0"
                    BorderThickness="1"
                    BorderBrush="#CCCCCC"
                    Margin="5"
                    Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- NEW: Mapping Tabs Section -->
                    <TabControl Grid.Row="0"
                                x:Name="MappingTabsControl"
                                Margin="0,0,0,10"
                                SelectionChanged="MappingTabsControl_SelectionChanged">
                        <TabControl.Resources>
                            <Style TargetType="TabItem">
                                <Setter Property="MinWidth"
                                        Value="80"/>
                                <Setter Property="Padding"
                                        Value="8,3"/>
                            </Style>
                        </TabControl.Resources>
                        <!-- Tabs will be added here programmatically -->
                    </TabControl>

                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Face Buttons -->
                        <GroupBox Grid.Row="0"
                                  Header="Face Buttons"
                                  Margin="0,5">
                            <Grid Margin="5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Header row with improved styling -->
                                <TextBlock Grid.Row="0"
                                           Grid.Column="0"
                                           Text="Button"
                                           FontWeight="Bold"
                                           Margin="5"
                                           Padding="3"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Grid.Row="0"
                                           Grid.Column="1"
                                           Text="Note"
                                           FontWeight="Bold"
                                           Margin="5"
                                           Padding="3"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Grid.Row="0"
                                           Grid.Column="2"
                                           Text="Ch"
                                           FontWeight="Bold"
                                           Margin="5"
                                           Padding="3"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Grid.Row="0"
                                           Grid.Column="3"
                                           Text="MIDI Device"
                                           FontWeight="Bold"
                                           Margin="5"
                                           Padding="3"
                                           HorizontalAlignment="Center"/>

                                <!-- Y Button -->
                                <Border Grid.Row="1"
                                        Grid.Column="0"
                                        Width="24"
                                        Height="24"
                                        CornerRadius="12"
                                        Background="#FFFFE200"
                                        Margin="5"
                                        BorderBrush="Black"
                                        BorderThickness="1">
                                    <TextBlock Text="Y"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Foreground="Black"/>
                                </Border>
                                <ComboBox Grid.Row="1"
                                          Grid.Column="1"
                                          x:Name="YButtonNoteCombo"
                                          Margin="5"
                                          Width="85"/>
                                <ComboBox Grid.Row="1"
                                          Grid.Column="2"
                                          x:Name="YChannelCombo"
                                          Margin="5"
                                          Width="45"/>
                                <ComboBox Grid.Row="1"
                                          Grid.Column="3"
                                          x:Name="YDeviceCombo"
                                          Margin="5"
                                          MinWidth="200"/>

                                <!-- B Button -->
                                <Border Grid.Row="2"
                                        Grid.Column="0"
                                        Width="24"
                                        Height="24"
                                        CornerRadius="12"
                                        Background="#FFE50000"
                                        Margin="5"
                                        BorderBrush="Black"
                                        BorderThickness="1">
                                    <TextBlock Text="B"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Foreground="White"/>
                                </Border>
                                <ComboBox Grid.Row="2"
                                          Grid.Column="1"
                                          x:Name="BButtonNoteCombo"
                                          Margin="5"
                                          Width="85"/>
                                <ComboBox Grid.Row="2"
                                          Grid.Column="2"
                                          x:Name="BChannelCombo"
                                          Margin="5"
                                          Width="45"/>
                                <ComboBox Grid.Row="2"
                                          Grid.Column="3"
                                          x:Name="BDeviceCombo"
                                          Margin="5"
                                          MinWidth="200"/>

                                           <!-- A Button -->
                                <Border Grid.Row="3"
                                        Grid.Column="0"
                                        Width="24"
                                        Height="24"
                                        CornerRadius="12"
                                        Background="#FF00B300"
                                        Margin="5"
                                        BorderBrush="Black"
                                        BorderThickness="1">
                                    <TextBlock Text="A"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Foreground="White"/>
                                </Border>
                                <ComboBox Grid.Row="3"
                                          Grid.Column="1"
                                          x:Name="AButtonNoteCombo"
                                          Margin="5"
                                          Width="85"/>
                                <ComboBox Grid.Row="3"
                                          Grid.Column="2"
                                          x:Name="AChannelCombo"
                                          Margin="5"
                                          Width="45"/>
                                <ComboBox Grid.Row="3"
                                          Grid.Column="3"
                                          x:Name="ADeviceCombo"
                                          Margin="5"
                                          MinWidth="200"/>
                            

                                <!-- X Button -->
                                <Border Grid.Row="4"
                                        Grid.Column="0"
                                        Width="24"
                                        Height="24"
                                        CornerRadius="12"
                                        Background="#FF0085E5"
                                        Margin="5"
                                        BorderBrush="Black"
                                        BorderThickness="1">
                                    <TextBlock Text="X"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Foreground="White"/>
                                </Border>
                                <ComboBox Grid.Row="4"
                                          Grid.Column="1"
                                          x:Name="XButtonNoteCombo"
                                          Margin="5"
                                          Width="85"/>
                                <ComboBox Grid.Row="4"
                                          Grid.Column="2"
                                          x:Name="XChannelCombo"
                                          Margin="5"
                                          Width="45"/>
                                <ComboBox Grid.Row="4"
                                          Grid.Column="3"
                                          x:Name="XDeviceCombo"
                                          Margin="5"
                                          MinWidth="200"/>

                               </Grid>
                        </GroupBox>

                        <!-- D-Pad -->
                        <GroupBox Grid.Row="1"
                                  Header="D-Pad"
                                  Margin="0,5">
                            <Grid Margin="5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Header row with improved styling -->
                                <TextBlock Grid.Row="0"
                                           Grid.Column="0"
                                           Text="Button"
                                           FontWeight="Bold"
                                           Margin="5"
                                           Padding="3"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Grid.Row="0"
                                           Grid.Column="1"
                                           Text="Note"
                                           FontWeight="Bold"
                                           Margin="5"
                                           Padding="3"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Grid.Row="0"
                                           Grid.Column="2"
                                           Text="Ch"
                                           FontWeight="Bold"
                                           Margin="5"
                                           Padding="3"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Grid.Row="0"
                                           Grid.Column="3"
                                           Text="MIDI Device"
                                           FontWeight="Bold"
                                           Margin="5"
                                           Padding="3"
                                           HorizontalAlignment="Center"/>

                                <!-- DPad Up -->
                                <TextBlock Grid.Row="1"
                                           Grid.Column="0"
                                           Text="Up:"
                                           Margin="5"/>
                                <ComboBox Grid.Row="1"
                                          Grid.Column="1"
                                          x:Name="DPadUpNoteCombo"
                                          Margin="5"
                                          Width="85"/>
                                <ComboBox Grid.Row="1"
                                          Grid.Column="2"
                                          x:Name="DPadUpChannelCombo"
                                          Margin="5"
                                          Width="45"/>
                                <ComboBox Grid.Row="1"
                                          Grid.Column="3"
                                          x:Name="DPadUpDeviceCombo"
                                          Margin="5"
                                          MinWidth="200"/>

                                <!-- DPad Right -->
                                <TextBlock Grid.Row="2"
                                           Grid.Column="0"
                                           Text="Right:"
                                           Margin="5"/>
                                <ComboBox Grid.Row="2"
                                          Grid.Column="1"
                                          x:Name="DPadRightNoteCombo"
                                          Margin="5"
                                          Width="85"/>
                                <ComboBox Grid.Row="2"
                                          Grid.Column="2"
                                          x:Name="DPadRightChannelCombo"
                                          Margin="5"
                                          Width="45"/>
                                <ComboBox Grid.Row="2"
                                          Grid.Column="3"
                                          x:Name="DPadRightDeviceCombo"
                                          Margin="5"
                                          MinWidth="200"/>

                                <!-- DPad Down -->
                                <TextBlock Grid.Row="3"
                                           Grid.Column="0"
                                           Text="Down:"
                                           Margin="5"/>
                                <ComboBox Grid.Row="3"
                                          Grid.Column="1"
                                          x:Name="DPadDownNoteCombo"
                                          Margin="5"
                                          Width="85"/>
                                <ComboBox Grid.Row="3"
                                          Grid.Column="2"
                                          x:Name="DPadDownChannelCombo"
                                          Margin="5"
                                          Width="45"/>
                                <ComboBox Grid.Row="3"
                                          Grid.Column="3"
                                          x:Name="DPadDownDeviceCombo"
                                          Margin="5"
                                          MinWidth="200"/>

                                <!-- DPad Left -->
                                <TextBlock Grid.Row="4"
                                           Grid.Column="0"
                                           Text="Left:"
                                           Margin="5"/>
                                <ComboBox Grid.Row="4"
                                          Grid.Column="1"
                                          x:Name="DPadLeftNoteCombo"
                                          Margin="5"
                                          Width="85"/>
                                <ComboBox Grid.Row="4"
                                          Grid.Column="2"
                                          x:Name="DPadLeftChannelCombo"
                                          Margin="5"
                                          Width="45"/>
                                <ComboBox Grid.Row="4"
                                          Grid.Column="3"
                                          x:Name="DPadLeftDeviceCombo"
                                          Margin="5"
                                          MinWidth="200"/>
                            </Grid>
                        </GroupBox>
                    </Grid>

                    <!-- Moved buttons from footer to here -->
                    <StackPanel Grid.Row="2"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Margin="0,10,0,0">
                        <Button Content="Reset"
                                x:Name="ResetChordMappingsButton"
                                Margin="5"
                                Padding="10,5"
                                Click="ResetChordMappings_Click"/>
                        <Button Content="Rename"
                                x:Name="RenameChordMappingsButton"
                                Margin="5"
                                Padding="10,5"
                                Click="RenameChordMappings_Click"/>
                        <Button Content="Load"
                                x:Name="LoadChordMappingsButton"
                                Margin="5"
                                Padding="10,5"
                                Click="LoadChordMappings_Click"/>
                        <Button Content="Save"
                                x:Name="SaveChordMappingsButton"
                                Margin="5"
                                Padding="10,5"
                                Click="SaveChordMappings_Click"/>
                    </StackPanel>

                    <!-- Moved Chord Activity Log Section to left column -->
                    <GroupBox Grid.Row="3"
                              Header="Chord Activity"
                              Margin="0,10,0,0">
                        <ListBox x:Name="ChordActivityLog"
                                 Height="150"
                                 Margin="5"/>
                    </GroupBox>
                </Grid>
            </Border>

            <!-- Right column - Chord reference and sample chord section -->
            <Border Grid.Column="1"
                    BorderThickness="1"
                    BorderBrush="#CCCCCC"
                    Margin="5"
                    Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Chord Type Reference -->
                    <local:ChordModeReferenceView Grid.Row="0"/>

                    <!-- Chord Test Panel -->
                    <local:ChordSamplerView x:Name="ChordSamplerView"
                            Grid.Row="1"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>