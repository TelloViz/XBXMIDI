<!-- filepath: c:\Users\lolli\Desktop\dev\XBXMIDI\Views\ArpeggioMappingView.xaml -->
<UserControl x:Class="XB2Midi.Views.ArpeggioMappingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:XB2Midi.Views"
             mc:Ignorable="d"
             d:DesignHeight="600"
             d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header with instructions -->
        <Border Grid.Row="0"
                Background="#F0F0F0"
                Padding="10"
                Margin="0,0,0,10">
            <TextBlock TextWrapping="Wrap">
                <Bold>Arpeggio Mode:</Bold> Trigger arpeggios and control their patterns using the controller. (Not yet implemented)
            </TextBlock>
        </Border>

        <!-- Main content area -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <!-- Left column - Controller mapping visualization -->
            <Border Grid.Column="0"
                    BorderThickness="1"
                    BorderBrush="#CCCCCC"
                    Margin="5"
                    Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Mapping Tabs Section (will be implemented later) -->
                    <TabControl Grid.Row="0"
                                x:Name="MappingTabsControl"
                                Margin="0,0,0,10">
                        <TabControl.Resources>
                            <Style TargetType="TabItem">
                                <Setter Property="MinWidth"
                                        Value="80"/>
                                <Setter Property="Padding"
                                        Value="8,3"/>
                            </Style>
                        </TabControl.Resources>
                        <!-- Placeholder tab for future implementation -->
                        <TabItem Header="Default Pattern">
                            <TextBlock Text="Arpeggio patterns will be configurable here."
                                       Margin="10"
                                       TextWrapping="Wrap"/>
                        </TabItem>
                    </TabControl>

                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Face Buttons -->
                        <GroupBox Grid.Row="0"
                                  Header="Face Buttons"
                                  Margin="0,5">
                            <Grid Margin="5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Header row with improved styling -->
                                <TextBlock Grid.Row="0"
                                           Grid.Column="0"
                                           Text="Button"
                                           FontWeight="Bold"
                                           Margin="5"
                                           Padding="3"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Grid.Row="0"
                                           Grid.Column="1"
                                           Text="Arpeggio"
                                           FontWeight="Bold"
                                           Margin="5"
                                           Padding="3"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Grid.Row="0"
                                           Grid.Column="2"
                                           Text="Ch"
                                           FontWeight="Bold"
                                           Margin="5"
                                           Padding="3"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Grid.Row="0"
                                           Grid.Column="3"
                                           Text="MIDI Device"
                                           FontWeight="Bold"
                                           Margin="5"
                                           Padding="3"
                                           HorizontalAlignment="Center"/>

                                <!-- Y Button -->
                                <Border Grid.Row="1"
                                        Grid.Column="0"
                                        Width="24"
                                        Height="24"
                                        CornerRadius="12"
                                        Background="#FFFFE200"
                                        Margin="5"
                                        BorderBrush="Black"
                                        BorderThickness="1">
                                    <TextBlock Text="Y"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Foreground="Black"/>
                                </Border>
                                <ComboBox Grid.Row="1"
                                          Grid.Column="1"
                                          x:Name="YButtonArpeggioCombo"
                                          Margin="5"
                                          Width="85"
                                          IsEnabled="False"/>
                                <ComboBox Grid.Row="1"
                                          Grid.Column="2"
                                          x:Name="YChannelCombo"
                                          Margin="5"
                                          Width="45"
                                          IsEnabled="False"/>
                                <ComboBox Grid.Row="1"
                                          Grid.Column="3"
                                          x:Name="YDeviceCombo"
                                          Margin="5"
                                          MinWidth="200"
                                          IsEnabled="False"/>

                                <!-- B Button -->
                                <Border Grid.Row="2"
                                        Grid.Column="0"
                                        Width="24"
                                        Height="24"
                                        CornerRadius="12"
                                        Background="#FFE50000"
                                        Margin="5"
                                        BorderBrush="Black"
                                        BorderThickness="1">
                                    <TextBlock Text="B"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Foreground="White"/>
                                </Border>
                                <ComboBox Grid.Row="2"
                                          Grid.Column="1"
                                          x:Name="BButtonArpeggioCombo"
                                          Margin="5"
                                          Width="85"
                                          IsEnabled="False"/>
                                <ComboBox Grid.Row="2"
                                          Grid.Column="2"
                                          x:Name="BChannelCombo"
                                          Margin="5"
                                          Width="45"
                                          IsEnabled="False"/>
                                <ComboBox Grid.Row="2"
                                          Grid.Column="3"
                                          x:Name="BDeviceCombo"
                                          Margin="5"
                                          MinWidth="200"
                                          IsEnabled="False"/>

                                <!-- A Button -->
                                <Border Grid.Row="3"
                                        Grid.Column="0"
                                        Width="24"
                                        Height="24"
                                        CornerRadius="12"
                                        Background="#FF00B300"
                                        Margin="5"
                                        BorderBrush="Black"
                                        BorderThickness="1">
                                    <TextBlock Text="A"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Foreground="White"/>
                                </Border>
                                <ComboBox Grid.Row="3"
                                          Grid.Column="1"
                                          x:Name="AButtonArpeggioCombo"
                                          Margin="5"
                                          Width="85"
                                          IsEnabled="False"/>
                                <ComboBox Grid.Row="3"
                                          Grid.Column="2"
                                          x:Name="AChannelCombo"
                                          Margin="5"
                                          Width="45"
                                          IsEnabled="False"/>
                                <ComboBox Grid.Row="3"
                                          Grid.Column="3"
                                          x:Name="ADeviceCombo"
                                          Margin="5"
                                          MinWidth="200"
                                          IsEnabled="False"/>

                                <!-- X Button -->
                                <Border Grid.Row="4"
                                        Grid.Column="0"
                                        Width="24"
                                        Height="24"
                                        CornerRadius="12"
                                        Background="#FF0085E5"
                                        Margin="5"
                                        BorderBrush="Black"
                                        BorderThickness="1">
                                    <TextBlock Text="X"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Foreground="White"/>
                                </Border>
                                <ComboBox Grid.Row="4"
                                          Grid.Column="1"
                                          x:Name="XButtonArpeggioCombo"
                                          Margin="5"
                                          Width="85"
                                          IsEnabled="False"/>
                                <ComboBox Grid.Row="4"
                                          Grid.Column="2"
                                          x:Name="XChannelCombo"
                                          Margin="5"
                                          Width="45"
                                          IsEnabled="False"/>
                                <ComboBox Grid.Row="4"
                                          Grid.Column="3"
                                          x:Name="XDeviceCombo"
                                          Margin="5"
                                          MinWidth="200"
                                          IsEnabled="False"/>
                            </Grid>
                        </GroupBox>

                        <!-- D-Pad -->
                        <GroupBox Grid.Row="1"
                                  Header="D-Pad"
                                  Margin="0,5">
                            <Grid Margin="5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Header row with improved styling -->
                                <TextBlock Grid.Row="0"
                                           Grid.Column="0"
                                           Text="Button"
                                           FontWeight="Bold"
                                           Margin="5"
                                           Padding="3"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Grid.Row="0"
                                           Grid.Column="1"
                                           Text="Arpeggio"
                                           FontWeight="Bold"
                                           Margin="5"
                                           Padding="3"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Grid.Row="0"
                                           Grid.Column="2"
                                           Text="Ch"
                                           FontWeight="Bold"
                                           Margin="5"
                                           Padding="3"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Grid.Row="0"
                                           Grid.Column="3"
                                           Text="MIDI Device"
                                           FontWeight="Bold"
                                           Margin="5"
                                           Padding="3"
                                           HorizontalAlignment="Center"/>

                                <!-- DPad Up -->
                                <TextBlock Grid.Row="1"
                                           Grid.Column="0"
                                           Text="Up:"
                                           Margin="5"/>
                                <ComboBox Grid.Row="1"
                                          Grid.Column="1"
                                          x:Name="DPadUpArpeggioCombo"
                                          Margin="5"
                                          Width="85"
                                          IsEnabled="False"/>
                                <ComboBox Grid.Row="1"
                                          Grid.Column="2"
                                          x:Name="DPadUpChannelCombo"
                                          Margin="5"
                                          Width="45"
                                          IsEnabled="False"/>
                                <ComboBox Grid.Row="1"
                                          Grid.Column="3"
                                          x:Name="DPadUpDeviceCombo"
                                          Margin="5"
                                          MinWidth="200"
                                          IsEnabled="False"/>

                                <!-- DPad Right -->
                                <TextBlock Grid.Row="2"
                                           Grid.Column="0"
                                           Text="Right:"
                                           Margin="5"/>
                                <ComboBox Grid.Row="2"
                                          Grid.Column="1"
                                          x:Name="DPadRightArpeggioCombo"
                                          Margin="5"
                                          Width="85"
                                          IsEnabled="False"/>
                                <ComboBox Grid.Row="2"
                                          Grid.Column="2"
                                          x:Name="DPadRightChannelCombo"
                                          Margin="5"
                                          Width="45"
                                          IsEnabled="False"/>
                                <ComboBox Grid.Row="2"
                                          Grid.Column="3"
                                          x:Name="DPadRightDeviceCombo"
                                          Margin="5"
                                          MinWidth="200"
                                          IsEnabled="False"/>

                                <!-- DPad Down -->
                                <TextBlock Grid.Row="3"
                                           Grid.Column="0"
                                           Text="Down:"
                                           Margin="5"/>
                                <ComboBox Grid.Row="3"
                                          Grid.Column="1"
                                          x:Name="DPadDownArpeggioCombo"
                                          Margin="5"
                                          Width="85"
                                          IsEnabled="False"/>
                                <ComboBox Grid.Row="3"
                                          Grid.Column="2"
                                          x:Name="DPadDownChannelCombo"
                                          Margin="5"
                                          Width="45"
                                          IsEnabled="False"/>
                                <ComboBox Grid.Row="3"
                                          Grid.Column="3"
                                          x:Name="DPadDownDeviceCombo"
                                          Margin="5"
                                          MinWidth="200"
                                          IsEnabled="False"/>

                                <!-- DPad Left -->
                                <TextBlock Grid.Row="4"
                                           Grid.Column="0"
                                           Text="Left:"
                                           Margin="5"/>
                                <ComboBox Grid.Row="4"
                                          Grid.Column="1"
                                          x:Name="DPadLeftArpeggioCombo"
                                          Margin="5"
                                          Width="85"
                                          IsEnabled="False"/>
                                <ComboBox Grid.Row="4"
                                          Grid.Column="2"
                                          x:Name="DPadLeftChannelCombo"
                                          Margin="5"
                                          Width="45"
                                          IsEnabled="False"/>
                                <ComboBox Grid.Row="4"
                                          Grid.Column="3"
                                          x:Name="DPadLeftDeviceCombo"
                                          Margin="5"
                                          MinWidth="200"
                                          IsEnabled="False"/>
                            </Grid>
                        </GroupBox>
                    </Grid>

                    <!-- Control buttons -->
                    <StackPanel Grid.Row="2"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Margin="0,10,0,0">
                        <Button Content="Reset"
                                x:Name="ResetArpeggioMappingsButton"
                                Margin="5"
                                Padding="10,5"
                                IsEnabled="False"/>
                        <Button Content="Rename"
                                x:Name="RenameArpeggioMappingsButton"
                                Margin="5"
                                Padding="10,5"
                                IsEnabled="False"/>
                        <Button Content="Load"
                                x:Name="LoadArpeggioMappingsButton"
                                Margin="5"
                                Padding="10,5"
                                IsEnabled="False"/>
                        <Button Content="Save"
                                x:Name="SaveArpeggioMappingsButton"
                                Margin="5"
                                Padding="10,5"
                                IsEnabled="False"/>
                    </StackPanel>

                    <!-- Activity Log Section -->
                    <GroupBox Grid.Row="3"
                              Header="Arpeggio Activity"
                              Margin="0,10,0,0">
                        <ListBox x:Name="ArpeggioActivityLog"
                                 Height="150"
                                 Margin="5"/>
                    </GroupBox>
                </Grid>
            </Border>

            <!-- Right column - Arpeggio configuration and settings -->
            <Border Grid.Column="1"
                    BorderThickness="1"
                    BorderBrush="#CCCCCC"
                    Margin="5"
                    Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Arpeggio Configuration Section -->
                    <GroupBox Grid.Row="0"
                              Header="Arpeggio Configuration"
                              Margin="0,0,0,10">
                        <StackPanel Margin="10">
                            <TextBlock Text="This feature will allow you to configure arpeggio patterns, rates, and directions."
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,10"/>
                            
                            <!-- Pattern Controls (disabled for now) -->
                            <Grid Margin="0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="Pattern:"
                                           Margin="0,0,10,0"
                                           VerticalAlignment="Center"/>
                                <ComboBox Grid.Column="1"
                                          IsEnabled="False">
                                    <ComboBoxItem Content="Up"/>
                                    <ComboBoxItem Content="Down"/>
                                    <ComboBoxItem Content="Up-Down"/>
                                    <ComboBoxItem Content="Down-Up"/>
                                    <ComboBoxItem Content="Random"/>
                                </ComboBox>
                            </Grid>
                            
                            <!-- Rate Controls (disabled for now) -->
                            <Grid Margin="0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="Rate:"
                                           Margin="0,0,10,0"
                                           VerticalAlignment="Center"/>
                                <ComboBox Grid.Column="1"
                                          IsEnabled="False">
                                    <ComboBoxItem Content="1/4 Note"/>
                                    <ComboBoxItem Content="1/8 Note"/>
                                    <ComboBoxItem Content="1/16 Note"/>
                                    <ComboBoxItem Content="Triplet"/>
                                </ComboBox>
                            </Grid>
                            
                            <!-- Octave Range Controls (disabled for now) -->
                            <Grid Margin="0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="Octave Range:"
                                           Margin="0,0,10,0"
                                           VerticalAlignment="Center"/>
                                <ComboBox Grid.Column="1"
                                          IsEnabled="False">
                                    <ComboBoxItem Content="1 Octave"/>
                                    <ComboBoxItem Content="2 Octaves"/>
                                    <ComboBoxItem Content="3 Octaves"/>
                                </ComboBox>
                            </Grid>
                        </StackPanel>
                    </GroupBox>

                    <!-- Arpeggio Message -->
                    <Border Grid.Row="1"
                            Background="#FFFFF0D0"
                            Padding="15"
                            Margin="0,0,0,10"
                            CornerRadius="5">
                        <TextBlock x:Name="MessageTextBlock" 
                                   Text="Arpeggio Mode is not yet implemented. Coming soon!" 
                                   FontSize="14" 
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"/>
                    </Border>
                </Grid> 
            </Border>
        </Grid>
    </Grid>
</UserControl>