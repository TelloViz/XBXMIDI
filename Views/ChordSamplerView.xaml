<UserControl x:Class="XB2Midi.Views.ChordSamplerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:XB2Midi.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <GroupBox Header="Sample Chord" Margin="0,5">
        <Grid Margin="5">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Root note selection and play button in top row -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Orientation="Horizontal">
                    <TextBlock Text="Root:"
                                Margin="5,0,5,0"
                                VerticalAlignment="Center"/>
                    <ComboBox x:Name="TestChordRootCombo"
                              Width="70"
                              Margin="0,5,5,5"
                              SelectedItem="{Binding SelectedRootNote, Mode=TwoWay}"/>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal">
                    <TextBlock Text="Inversion:"
                                Margin="5,0,5,0"
                                VerticalAlignment="Center"/>
                    <ComboBox x:Name="ChordInversionCombo"
                              Width="110"
                              Margin="0,5,5,5"
                              SelectedIndex="{Binding SelectedInversion, Mode=TwoWay}"/>
                </StackPanel>

                <Button Grid.Column="3"
                        x:Name="PlayChordButton"
                        Content="Play Chord"
                        Width="110"
                        Height="30"
                        Padding="5,3"
                        Margin="5,5,5,5"
                        Background="#FFD5F7D5"
                        FontWeight="SemiBold"
                        Command="{Binding PlayChordCommand}"/>

                <Button Grid.Column="4"
                        x:Name="ClearChordButton"
                        Content="Clear"
                        Width="70"
                        Height="30"
                        Padding="5,3"
                        Margin="5,5,5,5"
                        Background="#FFFFF0D0"
                        FontWeight="SemiBold"
                        Command="{Binding ClearChordCommand}"/>
            </Grid>

            <!-- Note toggles in distinct groups -->
            <GroupBox Grid.Row="1"
                      Header="Notes"
                      Margin="0,5,0,0"
                      BorderBrush="#FFAAAAAA">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <!-- Evenly distribute columns -->
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Root Section -->
                    <StackPanel Grid.Column="0"
                                Orientation="Vertical"
                                HorizontalAlignment="Center">
                        <TextBlock Text="Root"
                                   FontSize="11"
                                   HorizontalAlignment="Center"
                                   Margin="0,2"/>
                        <ToggleButton x:Name="RootToggle"
                                      Content="Root"
                                      Width="48"
                                      Margin="3"
                                      Padding="3,3"
                                      IsChecked="{Binding RootToggleChecked, Mode=TwoWay}"
                                      ToolTip="Root note"/>
                    </StackPanel>

                    <!-- Separator -->
                    <Rectangle Grid.Column="1"
                               Width="1"
                               Fill="#FFCCCCCC"
                               Margin="2,5"/>

                    <!-- Third options -->
                    <StackPanel Grid.Column="2"
                                Orientation="Vertical"
                                HorizontalAlignment="Center">
                        <TextBlock Text="Third"
                                   FontSize="11"
                                   HorizontalAlignment="Center"
                                   Margin="0,2"/>
                        <UniformGrid Columns="2">
                            <ToggleButton x:Name="MinThirdToggle"
                                          Content="♭3"
                                          Width="40"
                                          Margin="3"
                                          Padding="3,3"
                                          IsChecked="{Binding MinThirdToggleChecked, Mode=TwoWay}"
                                          ToolTip="Minor third (3 semitones)"/>
                            <ToggleButton x:Name="MajThirdToggle"
                                          Content="3"
                                          Width="40"
                                          Margin="3"
                                          Padding="3,3"
                                          IsChecked="{Binding MajThirdToggleChecked, Mode=TwoWay}"
                                          ToolTip="Major third (4 semitones)"/>

                        </UniformGrid>
                    </StackPanel>

                    <!-- Separator -->
                    <Rectangle Grid.Column="3"
                               Width="1"
                               Fill="#FFCCCCCC"
                               Margin="2,5"/>

                    <!-- Fifth options -->
                    <StackPanel Grid.Column="4"
                                Orientation="Vertical"
                                HorizontalAlignment="Center">
                        <TextBlock Text="Fifth"
                                   FontSize="11"
                                   HorizontalAlignment="Center"
                                   Margin="0,2"/>
                        <UniformGrid Columns="2">
                            <ToggleButton x:Name="FlatFifthToggle"
                                          Content="♭5"
                                          Width="40"
                                          Margin="3"
                                          Padding="3,3"
                                          IsChecked="{Binding FlatFifthToggleChecked, Mode=TwoWay}"
                                          ToolTip="Diminished fifth (6 semitones)"/>
                            <ToggleButton x:Name="FifthToggle"
                                          Content="5"
                                          Width="40"
                                          Margin="3"
                                          Padding="3,3"
                                          IsChecked="{Binding FifthToggleChecked, Mode=TwoWay}"
                                          ToolTip="Perfect fifth (7 semitones)"/>

                        </UniformGrid>
                    </StackPanel>

                    <!-- Separator -->
                    <Rectangle Grid.Column="5"
                               Width="1"
                               Fill="#FFCCCCCC"
                               Margin="2,5"/>

                    <!-- Extensions container -->
                    <StackPanel Grid.Column="6"
                                Orientation="Vertical"
                                HorizontalAlignment="Center">
                        <TextBlock Text="Extensions"
                                   FontSize="11"
                                   HorizontalAlignment="Center"
                                   Margin="0,2"/>
                        <UniformGrid Columns="3"
                                     Rows="2">
                            <ToggleButton x:Name="SixthToggle"
                                          Content="6"
                                          Width="35"
                                          Margin="2"
                                          Padding="2,2"
                                          IsChecked="{Binding SixthToggleChecked, Mode=TwoWay}"
                                          ToolTip="Major sixth (9 semitones)"/>
                            <ToggleButton x:Name="DomSeventhToggle"
                                          Content="♭7"
                                          Width="35"
                                          Margin="2"
                                          Padding="2,2"
                                          IsChecked="{Binding DomSeventhToggleChecked, Mode=TwoWay}"
                                          ToolTip="Dominant seventh (10 semitones)"/>
                            <ToggleButton x:Name="MajSeventhToggle"
                                          Content="7"
                                          Width="35"
                                          Margin="2"
                                          Padding="2,2"
                                          IsChecked="{Binding MajSeventhToggleChecked, Mode=TwoWay}"
                                          ToolTip="Major seventh (11 semitones)"/>
                            <ToggleButton x:Name="NinthToggle"
                                          Content="9"
                                          Width="35"
                                          Margin="2"
                                          Padding="2,2"
                                          IsChecked="{Binding NinthToggleChecked, Mode=TwoWay}"
                                          ToolTip="Major ninth (14 semitones)"/>
                            <ToggleButton x:Name="FlatNinthToggle"
                                          Content="♭9"
                                          Width="35"
                                          Margin="2"
                                          Padding="2,2"
                                          IsChecked="{Binding FlatNinthToggleChecked, Mode=TwoWay}"
                                          ToolTip="Flat ninth (13 semitones)"/>
                            <!-- Empty space for alignment -->
                            <Border Width="35"
                                    Margin="2"
                                    Background="Transparent"/>
                        </UniformGrid>
                    </StackPanel>
                </Grid>
            </GroupBox>

            <!-- Preset buttons in a single row with even distribution -->
            <GroupBox Grid.Row="2"
                      Header="Presets"
                      Margin="0,5,0,0"
                      BorderBrush="#FFAAAAAA">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Content="Minor"
                            Margin="2"
                            Padding="5,3"
                            Command="{Binding ChordPresetCommand}"
                            CommandParameter="Minor"
                            HorizontalAlignment="Stretch"/>
                    <Button Grid.Column="1"
                            Content="Major"
                            Margin="2"
                            Padding="5,3"
                            Command="{Binding ChordPresetCommand}"
                            CommandParameter="Major"
                            HorizontalAlignment="Stretch"/>
                    <Button Grid.Column="2"
                            Content="Min7"
                            Margin="2"
                            Padding="5,3"
                            Command="{Binding ChordPresetCommand}"
                            CommandParameter="Min7"
                            HorizontalAlignment="Stretch"/>
                    <Button Grid.Column="3"
                            Content="Maj7"
                            Margin="2"
                            Padding="5,3"
                            Command="{Binding ChordPresetCommand}"
                            CommandParameter="Maj7"
                            HorizontalAlignment="Stretch"/>
                    <Button Grid.Column="4"
                            Content="Dom7"
                            Margin="2"
                            Padding="5,3"
                            Command="{Binding ChordPresetCommand}"
                            CommandParameter="Dom7"
                            HorizontalAlignment="Stretch"/>
                    <Button Grid.Column="5"
                            Content="Dim"
                            Margin="2"
                            Padding="5,3"
                            Command="{Binding ChordPresetCommand}"
                            CommandParameter="Dim"
                            HorizontalAlignment="Stretch"/>
                    <Button Grid.Column="6"
                            Content="Sus4"
                            Margin="2"
                            Padding="5,3"
                            Command="{Binding ChordPresetCommand}"
                            CommandParameter="Sus4"
                            HorizontalAlignment="Stretch"/>
                    <Button Grid.Column="7"
                            Content="Add9"
                            Margin="2"
                            Padding="5,3"
                            Command="{Binding ChordPresetCommand}"
                            CommandParameter="Add9"
                            HorizontalAlignment="Stretch"/>
                    <Button Grid.Column="8"
                            Content="6"
                            Margin="2"
                            Padding="5,3"
                            Command="{Binding ChordPresetCommand}"
                            CommandParameter="6"
                            HorizontalAlignment="Stretch"/>
                    <Button Grid.Column="9"
                            Content="m6"
                            Margin="2"
                            Padding="5,3"
                            Command="{Binding ChordPresetCommand}"
                            CommandParameter="m6"
                            HorizontalAlignment="Stretch"/>
                </Grid>
            </GroupBox>
        </Grid>
    </GroupBox>
</UserControl>