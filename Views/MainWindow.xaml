<Window x:Class="XB2Midi.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:XB2Midi.Views"
        xmlns:converters="clr-namespace:XB2Midi.Converters"
        Title="XB2Midi" Height="850" Width="1440">
    <Window.Resources>
        <converters:MidiTypeToEnabledConverter x:Key="MidiTypeToEnabledConverter"/>
    </Window.Resources>
    <Grid>
        <TabControl>
            <!-- Commented out Devices tab -->
            <!--
            <TabItem Header="Devices">
                <Grid>
                    <StackPanel Margin="10">
                        <GroupBox Header="MIDI Output Devices" Margin="0,0,0,10">
                            <StackPanel Margin="10">
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,10">
                                    <ComboBox x:Name="GlobalDeviceComboBox" Width="300" Margin="0,0,10,0"/>
                                    <Button Content="Refresh" Click="RefreshDevicesButton_Click" Width="100"/>
                                    <Button Content="Test Note" Click="TestNoteButton_Click" Width="100" Margin="10,0,0,0"/>
                                </StackPanel>
                                <TextBlock x:Name="ModeDisplay" Text="Mode: Basic" FontWeight="Bold" Margin="0,10,0,0"/>
                            </StackPanel>
                        </GroupBox>
                        
                        <GroupBox Header="Controller Status">
                            <TextBlock x:Name="ControllerStatus" Text="Controller: Disconnected" Padding="10"/>
                        </GroupBox>
                        
                        <GroupBox Header="MIDI Activity">
                            <ListBox x:Name="MidiActivityLog" Height="200" Margin="10"/>
                        </GroupBox>
                    </StackPanel>
                </Grid>
            </TabItem>
            -->
            
            <!-- Basic Mode Mapping Tab -->
            <TabItem Header="Basic" x:Name="BasicMappingTab">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Header -->
                        <RowDefinition Height="Auto"/> <!-- Mapping Controls & Buttons -->
                        <RowDefinition Height="*"/>     <!-- Mappings List and MIDI Activity -->
                    </Grid.RowDefinitions>
                    
                    <!-- Header -->
                    <TextBlock Grid.Row="0" Text="Map controller inputs to MIDI messages" 
                             FontWeight="Bold" Margin="0,0,0,10"/>
                    
                    <!-- Mapping configuration area and Actions side-by-side -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <!-- Define New Mapping section - Left -->
                        <GroupBox Grid.Column="0" Header="Define New Mapping" Margin="0,0,5,10">
                            <Grid Margin="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Controller Input:" VerticalAlignment="Center" Margin="0,0,10,10"/>
                                <ComboBox Grid.Row="0" Grid.Column="1" x:Name="ControllerInputComboBox" Margin="0,0,0,10"/>
                                
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="MIDI Message Type:" VerticalAlignment="Center" Margin="0,0,10,10"/>
                                <ComboBox Grid.Row="1" Grid.Column="1" x:Name="MidiTypeComboBox" Margin="0,0,0,10" 
                                         SelectionChanged="MidiTypeComboBox_SelectionChanged">
                                    <ComboBoxItem Content="Note" IsSelected="True"/>
                                    <ComboBoxItem Content="Control Change"/>
                                    <ComboBoxItem Content="Pitch Bend"/>
                                </ComboBox>
                                
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="MIDI Device:" VerticalAlignment="Center" Margin="0,0,10,10"/>
                                <ComboBox Grid.Row="2" Grid.Column="1" x:Name="BasicMappingDeviceComboBox" Margin="0,0,0,10"/>
                                
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="MIDI Channel (1-16):" VerticalAlignment="Center" Margin="0,0,10,10"/>
                                <TextBox Grid.Row="3" Grid.Column="1" x:Name="MidiChannelTextBox" Margin="0,0,0,10" Text="1"/>
                                
                                <TextBlock Grid.Row="4" Grid.Column="0" Text="MIDI Value (0-127):" VerticalAlignment="Center" Margin="0,0,10,10"/>
                                <TextBox Grid.Row="4" Grid.Column="1" x:Name="MidiValueTextBox" Margin="0,0,0,10"/>
                            </Grid>
                        </GroupBox>
                        
                        <!-- Actions section - Right, with 2-column button layout -->
                        <GroupBox Grid.Column="1" Header="Actions" Margin="5,0,0,10">
                            <Grid Margin="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                
                                <!-- Row 1: Add Mapping and Refresh Devices -->
                                <Button Grid.Row="0" Grid.Column="0" Content="Add Mapping" Click="AddMapping_Click" 
                                       Margin="0,0,5,5" Padding="5,8" FontWeight="Bold" />
                                <Button Grid.Row="0" Grid.Column="1" Content="Refresh Devices" Click="RefreshDevicesButton_Click" 
                                       Margin="5,0,0,5" Padding="5,8" />
                                
                                <!-- Row 2: Save Mappings and Load Mappings -->
                                <Button Grid.Row="1" Grid.Column="0" Content="Save Mappings" Click="SaveMappings_Click" 
                                       Margin="0,5,5,5" Padding="5,8" />
                                <Button Grid.Row="1" Grid.Column="1" Content="Load Mappings" Click="LoadMappings_Click" 
                                       Margin="5,5,0,5" Padding="5,8" />
                                
                                <!-- Row 3: Delete Selected -->
                                <Button Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Content="Delete Selected" Click="DeleteMapping_Click" 
                                       Margin="0,5,0,0" Padding="5,8" />
                            </Grid>
                        </GroupBox>
                    </Grid>
                    
                    <!-- Mappings List and MIDI Activity in two columns with GroupBoxes -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <!-- Mappings List Section -->
                        <GroupBox Grid.Column="0" Header="Current Mappings" Margin="0,0,5,0">
                            <ListView x:Name="MappingsListView" Margin="10">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="Controller Input" Width="100" DisplayMemberBinding="{Binding ControllerInput}"/>
                                        <GridViewColumn Header="Message Type" Width="100" DisplayMemberBinding="{Binding MessageType}"/>
                                        <GridViewColumn Header="Device" Width="80" DisplayMemberBinding="{Binding MidiDeviceIndex}"/>
                                        <GridViewColumn Header="Ch" Width="30" DisplayMemberBinding="{Binding DisplayChannel}"/>
                                        <GridViewColumn Header="Value" Width="40" DisplayMemberBinding="{Binding DisplayValue}"/>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </GroupBox>
                        
                        <!-- MIDI Activity Column -->
                        <GroupBox Grid.Column="1" Header="MIDI Activity" Margin="5,0,0,0">
                            <ListBox x:Name="MidiActivityLog" Margin="10"/>
                        </GroupBox>
                    </Grid>
                </Grid>
            </TabItem>
            
            <!-- Chord Mode Mapping Tab -->
            <TabItem x:Name="ChordMappingTab" Header="Chord">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Header with instructions -->
                    <Border Grid.Row="0" Background="#F0F0F0" Padding="10" Margin="0,0,0,10">
                        <TextBlock TextWrapping="Wrap">
                            <Bold>Chord Mode:</Bold> Play roots, chords, and extensions using the controller.
                        </TextBlock>
                    </Border>
                    
                    <!-- Main content area -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="3*"/>
                        </Grid.ColumnDefinitions>
                        
                        <!-- Left column - Controller mapping visualization -->
                        <Border Grid.Column="0" BorderThickness="1" BorderBrush="#CCCCCC" Margin="5" Padding="10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                
                                <!-- NEW: Mapping Tabs Section -->
                                <TabControl Grid.Row="0" x:Name="MappingTabsControl" Margin="0,0,0,10" 
                                          SelectionChanged="MappingTabsControl_SelectionChanged">
                                    <TabControl.Resources>
                                        <Style TargetType="TabItem">
                                            <Setter Property="MinWidth" Value="80"/>
                                            <Setter Property="Padding" Value="8,3"/>
                                        </Style>
                                    </TabControl.Resources>
                                    <!-- Tabs will be added here programmatically -->
                                </TabControl>
                                
                                <Grid Grid.Row="1">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    
                                    <!-- Face Buttons -->
                                    <GroupBox Grid.Row="0" Header="Face Buttons" Margin="0,5">
                                        <Grid Margin="5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/> 
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            
                                            <!-- Header row with improved styling -->
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Button" FontWeight="Bold" Margin="5" 
                                                      Padding="3" HorizontalAlignment="Center"/>
                                            <TextBlock Grid.Row="0" Grid.Column="1" Text="Note" FontWeight="Bold" Margin="5" 
                                                      Padding="3" HorizontalAlignment="Center"/>
                                            <TextBlock Grid.Row="0" Grid.Column="2" Text="Ch" FontWeight="Bold" Margin="5" 
                                                     Padding="3" HorizontalAlignment="Center"/>
                                            <TextBlock Grid.Row="0" Grid.Column="3" Text="MIDI Device" FontWeight="Bold" Margin="5" 
                                                     Padding="3" HorizontalAlignment="Center"/>
                                            
                                            <!-- Y Button -->
                                            <Border Grid.Row="1" Grid.Column="0" Width="24" Height="24" CornerRadius="12" Background="#FFFFE200" Margin="5" BorderBrush="Black" BorderThickness="1">
                                                <TextBlock Text="Y" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="Black"/>
                                            </Border>
                                            <ComboBox Grid.Row="1" Grid.Column="1" x:Name="YButtonNoteCombo" Margin="5" Width="85"/>
                                            <ComboBox Grid.Row="1" Grid.Column="2" x:Name="YChannelCombo" Margin="5" Width="45"/>
                                            <ComboBox Grid.Row="1" Grid.Column="3" x:Name="YDeviceCombo" Margin="5" MinWidth="200"/>
                                            
                                            <!-- B Button -->
                                            <Border Grid.Row="2" Grid.Column="0" Width="24" Height="24" CornerRadius="12" Background="#FFE50000" Margin="5" BorderBrush="Black" BorderThickness="1">
                                                <TextBlock Text="B" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White"/>
                                            </Border>
                                            <ComboBox Grid.Row="2" Grid.Column="1" x:Name="BButtonNoteCombo" Margin="5" Width="85"/>
                                            <ComboBox Grid.Row="2" Grid.Column="2" x:Name="BChannelCombo" Margin="5" Width="45"/>
                                            <ComboBox Grid.Row="2" Grid.Column="3" x:Name="BDeviceCombo" Margin="5" MinWidth="200"/>
                                            
                                            <!-- X Button -->
                                            <Border Grid.Row="3" Grid.Column="0" Width="24" Height="24" CornerRadius="12" Background="#FF0085E5" Margin="5" BorderBrush="Black" BorderThickness="1">
                                                <TextBlock Text="X" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White"/>
                                            </Border>
                                            <ComboBox Grid.Row="3" Grid.Column="1" x:Name="XButtonNoteCombo" Margin="5" Width="85"/>
                                            <ComboBox Grid.Row="3" Grid.Column="2" x:Name="XChannelCombo" Margin="5" Width="45"/>
                                            <ComboBox Grid.Row="3" Grid.Column="3" x:Name="XDeviceCombo" Margin="5" MinWidth="200"/>
                                            
                                            <!-- A Button -->
                                            <Border Grid.Row="4" Grid.Column="0" Width="24" Height="24" CornerRadius="12" Background="#FF00B300" Margin="5" BorderBrush="Black" BorderThickness="1">
                                                <TextBlock Text="A" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White"/>
                                            </Border>
                                            <ComboBox Grid.Row="4" Grid.Column="1" x:Name="AButtonNoteCombo" Margin="5" Width="85"/>
                                            <ComboBox Grid.Row="4" Grid.Column="2" x:Name="AChannelCombo" Margin="5" Width="45"/>
                                            <ComboBox Grid.Row="4" Grid.Column="3" x:Name="ADeviceCombo" Margin="5" MinWidth="200"/>
                                        </Grid>
                                    </GroupBox>
                                    
                                    <!-- D-Pad -->
                                    <GroupBox Grid.Row="1" Header="D-Pad" Margin="0,5">
                                        <Grid Margin="5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/> 
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            
                                            <!-- Header row with improved styling -->
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Button" FontWeight="Bold" Margin="5" 
                                                    Padding="3" HorizontalAlignment="Center"/>
                                            <TextBlock Grid.Row="0" Grid.Column="1" Text="Note" FontWeight="Bold" Margin="5" 
                                                    Padding="3" HorizontalAlignment="Center"/>
                                            <TextBlock Grid.Row="0" Grid.Column="2" Text="Ch" FontWeight="Bold" Margin="5" 
                                                    Padding="3" HorizontalAlignment="Center"/>
                                            <TextBlock Grid.Row="0" Grid.Column="3" Text="MIDI Device" FontWeight="Bold" Margin="5" 
                                                    Padding="3" HorizontalAlignment="Center"/>
                                            
                                            <!-- DPad Up -->
                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Up:" Margin="5"/>
                                            <ComboBox Grid.Row="1" Grid.Column="1" x:Name="DPadUpNoteCombo" Margin="5" Width="85"/>
                                            <ComboBox Grid.Row="1" Grid.Column="2" x:Name="DPadUpChannelCombo" Margin="5" Width="45"/>
                                            <ComboBox Grid.Row="1" Grid.Column="3" x:Name="DPadUpDeviceCombo" Margin="5" MinWidth="200"/>
                                            
                                            <!-- DPad Right -->
                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Right:" Margin="5"/>
                                            <ComboBox Grid.Row="2" Grid.Column="1" x:Name="DPadRightNoteCombo" Margin="5" Width="85"/>
                                            <ComboBox Grid.Row="2" Grid.Column="2" x:Name="DPadRightChannelCombo" Margin="5" Width="45"/>
                                            <ComboBox Grid.Row="2" Grid.Column="3" x:Name="DPadRightDeviceCombo" Margin="5" MinWidth="200"/>
                                            
                                            <!-- DPad Down -->
                                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Down:" Margin="5"/>
                                            <ComboBox Grid.Row="3" Grid.Column="1" x:Name="DPadDownNoteCombo" Margin="5" Width="85"/>
                                            <ComboBox Grid.Row="3" Grid.Column="2" x:Name="DPadDownChannelCombo" Margin="5" Width="45"/>
                                            <ComboBox Grid.Row="3" Grid.Column="3" x:Name="DPadDownDeviceCombo" Margin="5" MinWidth="200"/>
                                            
                                            <!-- DPad Left -->
                                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Left:" Margin="5"/>
                                            <ComboBox Grid.Row="4" Grid.Column="1" x:Name="DPadLeftNoteCombo" Margin="5" Width="85"/>
                                            <ComboBox Grid.Row="4" Grid.Column="2" x:Name="DPadLeftChannelCombo" Margin="5" Width="45"/>
                                            <ComboBox Grid.Row="4" Grid.Column="3" x:Name="DPadLeftDeviceCombo" Margin="5" MinWidth="200"/>
                                        </Grid>
                                    </GroupBox>
                                </Grid>
                                
                                <!-- Moved buttons from footer to here -->
                                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                                    <Button Content="Reset" x:Name="ResetChordMappingsButton" Margin="5" Padding="10,5" Click="ResetChordMappings_Click"/>
                                    <Button Content="Rename" x:Name="RenameChordMappingsButton" Margin="5" Padding="10,5" Click="RenameChordMappings_Click"/>
                                    <Button Content="Load" x:Name="LoadChordMappingsButton" Margin="5" Padding="10,5" Click="LoadChordMappings_Click"/>
                                    <Button Content="Save" x:Name="SaveChordMappingsButton" Margin="5" Padding="10,5" Click="SaveChordMappings_Click"/>
                                </StackPanel>
                                
                                <!-- Moved Chord Activity Log Section to left column -->
                                <GroupBox Grid.Row="3" Header="Chord Activity" Margin="0,10,0,0">
                                    <ListBox x:Name="ChordActivityLog" Height="150" Margin="5"/>
                                </GroupBox>
                            </Grid>
                        </Border>
                        
                        <!-- Right column - Chord reference and sample chord section -->
                        <Border Grid.Column="1" BorderThickness="1" BorderBrush="#CCCCCC" Margin="5" Padding="10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                
                                <!-- Chord Type Reference -->
                                <GroupBox Grid.Row="0" Header="Chord Mode Controls Reference" Margin="0,5">
                                    <Grid Margin="5">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <!-- Chord type reference (left column) -->
                                        <GroupBox Grid.Row="0" Grid.Column="0" Header="Chord Types" Margin="3" BorderBrush="#FFAAAAAA">
                                            <Grid Margin="3">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                    
                                                <TextBlock Grid.Row="0" Grid.Column="0" Text="No Bumpers:" Margin="5" FontWeight="Bold"/>
                                                <TextBlock Grid.Row="0" Grid.Column="1" Text="Root Note Only" Margin="5"/>
                                                
                                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Left Bumper (LB):" Margin="5" FontWeight="Bold"/>
                                                <TextBlock Grid.Row="1" Grid.Column="1" Text="Minor Triad (1-b3-5)" Margin="5"/>
                                                
                                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Right Bumper (RB):" Margin="5" FontWeight="Bold"/>
                                                <TextBlock Grid.Row="2" Grid.Column="1" Text="Major Triad (1-3-5)" Margin="5"/>
                                                
                                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Double-Tap LB:" Margin="5" FontWeight="Bold"/>
                                                <TextBlock Grid.Row="3" Grid.Column="1" Text="Minor 7th Chord (1-b3-5-b7)" Margin="5"/>
                                                
                                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Double-Tap RB:" Margin="5" FontWeight="Bold"/>
                                                <TextBlock Grid.Row="4" Grid.Column="1" Text="Major 7th Chord (1-3-5-7)" Margin="5"/>
                                                
                                                <TextBlock Grid.Row="5" Grid.Column="0" Text="Triple-Tap LB:" Margin="5" FontWeight="Bold"/>
                                                <TextBlock Grid.Row="5" Grid.Column="1" Text="Minor 9th Chord (1-b3-5-b7-9)" Margin="5"/>
                                                
                                                <TextBlock Grid.Row="6" Grid.Column="0" Text="Triple-Tap RB:" Margin="5" FontWeight="Bold"/>
                                                <TextBlock Grid.Row="6" Grid.Column="1" Text="Major 9th Chord (1-3-5-7-9)" Margin="5"/>
                                                
                                                <TextBlock Grid.Row="7" Grid.Column="0" Text="Both Bumpers:" Margin="5" FontWeight="Bold"/>
                                                <TextBlock Grid.Row="7" Grid.Column="1" Text="Diminished Triad (1-b3-b5)" Margin="5"/>
                                            </Grid>
                                        </GroupBox>
                                        
                                        <!-- Modifiers reference (right column) -->
                                        <GroupBox Grid.Row="0" Grid.Column="1" Header="Modifiers" Margin="3" BorderBrush="#FFAAAAAA">
                                            <Grid Margin="3">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                
                                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Left Trigger:" Margin="5" FontWeight="Bold"/>
                                                <TextBlock Grid.Row="0" Grid.Column="1" Text="Control velocity (pressure-sensitive)" Margin="5"/>
                                                
                                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Right Trigger:" Margin="5" FontWeight="Bold"/>
                                                <TextBlock Grid.Row="1" Grid.Column="1" Text="Sustain notes when buttons are released" Margin="5"/>
                                                
                                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Left Joystick:" Margin="5" FontWeight="Bold" VerticalAlignment="Top"/>
                                                <StackPanel Grid.Row="2" Grid.Column="1" Margin="5">
                                                    <TextBlock Text="Change chord inversions:" TextWrapping="Wrap"/>
                                                    <TextBlock Text="• Center: Root position" Margin="10,2,0,0" TextWrapping="Wrap"/>
                                                    <TextBlock Text="• Up: 1st inversion" Margin="10,2,0,0" TextWrapping="Wrap"/>
                                                    <TextBlock Text="• Right: 2nd inversion" Margin="10,2,0,0" TextWrapping="Wrap"/>
                                                    <TextBlock Text="• Down: 3rd inversion (7th chords)" Margin="10,2,0,0" TextWrapping="Wrap"/>
                                                    <TextBlock Text="• Left: 4th inversion (9th chords)" Margin="10,2,0,0" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </Grid>
                                        </GroupBox>
                                        
                                        <!-- Root note buttons (spanning both columns) -->
                                        <GroupBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Header="Root Note Buttons" Margin="3" BorderBrush="#FFAAAAAA">
                                            <Grid Margin="3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                
                                                <TextBlock Grid.Column="0" Text="Face Buttons:" Margin="5" FontWeight="Bold"/>
                                                <TextBlock Grid.Column="1" Text="A, B, X, Y select respective root notes" Margin="5"/>
                                                
                                                <TextBlock Grid.Column="2" Text="D-Pad:" Margin="5" FontWeight="Bold"/>
                                                <TextBlock Grid.Column="3" Text="Up, Right, Down, Left select respective root notes" Margin="5"/>
                                            </Grid>
                                        </GroupBox>
                                    </Grid>
                                </GroupBox>
                                
                                <!-- Test Section - Redesigned with individual note toggles and optional root -->
                                <GroupBox Grid.Row="1" Header="Sample Chord" Margin="0,5">
                                    <Grid Margin="5">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        
                                        <!-- Root note selection and play button in top row -->
                                        <Grid Grid.Row="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            
                                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                <TextBlock Text="Root:" Margin="5,0,5,0" VerticalAlignment="Center"/>
                                                <ComboBox x:Name="TestChordRootCombo" Width="70" Margin="0,5,5,5"/>
                                            </StackPanel>
                                            
                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <TextBlock Text="Inversion:" Margin="5,0,5,0" VerticalAlignment="Center"/>
                                                <ComboBox x:Name="ChordInversionCombo" Width="110" Margin="0,5,5,5"/>
                                            </StackPanel>
                                            
                                            <Button Grid.Column="3" x:Name="PlayChordButton" Content="Play Chord" 
                                                   Width="110" Height="30" Padding="5,3" Margin="5,5,5,5"
                                                   Background="#FFD5F7D5" FontWeight="SemiBold"
                                                   Click="PlayCustomChord_Click"/>
                                            
                                            <Button Grid.Column="4" x:Name="ClearChordButton" Content="Clear" 
                                                   Width="70" Height="30" Padding="5,3" Margin="5,5,5,5"
                                                   Background="#FFFFF0D0" FontWeight="SemiBold"
                                                   Click="ClearChord_Click"/>
                                        </Grid>
                                        
                                        <!-- Note toggles in distinct groups -->
                                        <GroupBox Grid.Row="1" Header="Notes" Margin="0,5,0,0" BorderBrush="#FFAAAAAA">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <!-- Evenly distribute columns -->
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                
                                                <!-- Root Section -->
                                                <StackPanel Grid.Column="0" Orientation="Vertical" HorizontalAlignment="Center">
                                                    <TextBlock Text="Root" FontSize="11" HorizontalAlignment="Center" Margin="0,2"/>
                                                    <ToggleButton x:Name="RootToggle" Content="Root" Width="48" Margin="3" Padding="3,3" 
                                                                IsChecked="True" ToolTip="Root note"/>
                                                </StackPanel>
                                                
                                                <!-- Separator -->
                                                <Rectangle Grid.Column="1" Width="1" Fill="#FFCCCCCC" Margin="2,5"/>
                                                
                                                <!-- Third options -->
                                                <StackPanel Grid.Column="2" Orientation="Vertical" HorizontalAlignment="Center">
                                                    <TextBlock Text="Third" FontSize="11" HorizontalAlignment="Center" Margin="0,2"/>
                                                    <UniformGrid Columns="2">
                                                        <ToggleButton x:Name="MajThirdToggle" Content="3" Width="40" Margin="3" Padding="3,3" 
                                                                    IsChecked="True" ToolTip="Major third (4 semitones)"
                                                                    Click="NoteToggle_Click"/>
                                                        <ToggleButton x:Name="MinThirdToggle" Content="♭3" Width="40" Margin="3" Padding="3,3"
                                                                    IsChecked="False" ToolTip="Minor third (3 semitones)"
                                                                    Click="NoteToggle_Click"/>
                                                    </UniformGrid>
                                                </StackPanel>
                                                
                                                <!-- Separator -->
                                                <Rectangle Grid.Column="3" Width="1" Fill="#FFCCCCCC" Margin="2,5"/>
                                                
                                                <!-- Fifth options -->
                                                <StackPanel Grid.Column="4" Orientation="Vertical" HorizontalAlignment="Center">
                                                    <TextBlock Text="Fifth" FontSize="11" HorizontalAlignment="Center" Margin="0,2"/>
                                                    <UniformGrid Columns="2">
                                                        <ToggleButton x:Name="FifthToggle" Content="5" Width="40" Margin="3" Padding="3,3"
                                                                    IsChecked="True" ToolTip="Perfect fifth (7 semitones)"
                                                                    Click="NoteToggle_Click"/>
                                                        <ToggleButton x:Name="FlatFifthToggle" Content="♭5" Width="40" Margin="3" Padding="3,3"
                                                                    IsChecked="False" ToolTip="Diminished fifth (6 semitones)"
                                                                    Click="NoteToggle_Click"/>
                                                    </UniformGrid>
                                                </StackPanel>
                                                
                                                <!-- Separator -->
                                                <Rectangle Grid.Column="5" Width="1" Fill="#FFCCCCCC" Margin="2,5"/>
                                                
                                                <!-- Extensions container -->
                                                <StackPanel Grid.Column="6" Orientation="Vertical" HorizontalAlignment="Center">
                                                    <TextBlock Text="Extensions" FontSize="11" HorizontalAlignment="Center" Margin="0,2"/>
                                                    <UniformGrid Columns="3" Rows="2">
                                                        <ToggleButton x:Name="SixthToggle" Content="6" Width="35" Margin="2" Padding="2,2"
                                                                    IsChecked="False" ToolTip="Major sixth (9 semitones)"/>
                                                        <ToggleButton x:Name="DomSeventhToggle" Content="♭7" Width="35" Margin="2" Padding="2,2"
                                                                    IsChecked="False" ToolTip="Dominant seventh (10 semitones)"
                                                                    Click="NoteToggle_Click"/>
                                                        <ToggleButton x:Name="MajSeventhToggle" Content="7" Width="35" Margin="2" Padding="2,2"
                                                                    IsChecked="False" ToolTip="Major seventh (11 semitones)"
                                                                    Click="NoteToggle_Click"/>
                                                        <ToggleButton x:Name="NinthToggle" Content="9" Width="35" Margin="2" Padding="2,2"
                                                                    IsChecked="False" ToolTip="Major ninth (14 semitones)"
                                                                    Click="NoteToggle_Click"/>
                                                        <ToggleButton x:Name="FlatNinthToggle" Content="♭9" Width="35" Margin="2" Padding="2,2"
                                                                    IsChecked="False" ToolTip="Flat ninth (13 semitones)"
                                                                    Click="NoteToggle_Click"/>
                                                        <!-- Empty space for alignment -->
                                                        <Border Width="35" Margin="2" Background="Transparent"/>
                                                    </UniformGrid>
                                                </StackPanel>
                                            </Grid>
                                        </GroupBox>

                                        <!-- Preset buttons in a single row with even distribution -->
                                        <GroupBox Grid.Row="2" Header="Presets" Margin="0,5,0,0" BorderBrush="#FFAAAAAA">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <Button Grid.Column="0" Content="Major" Margin="2" Padding="5,3" Click="ChordPreset_Click" HorizontalAlignment="Stretch"/>
                                                <Button Grid.Column="1" Content="Minor" Margin="2" Padding="5,3" Click="ChordPreset_Click" HorizontalAlignment="Stretch"/>
                                                <Button Grid.Column="2" Content="Maj7" Margin="2" Padding="5,3" Click="ChordPreset_Click" HorizontalAlignment="Stretch"/>
                                                <Button Grid.Column="3" Content="Min7" Margin="2" Padding="5,3" Click="ChordPreset_Click" HorizontalAlignment="Stretch"/>
                                                <Button Grid.Column="4" Content="Dom7" Margin="2" Padding="5,3" Click="ChordPreset_Click" HorizontalAlignment="Stretch"/>
                                                <Button Grid.Column="5" Content="Dim" Margin="2" Padding="5,3" Click="ChordPreset_Click" HorizontalAlignment="Stretch"/>
                                                <Button Grid.Column="6" Content="Sus4" Margin="2" Padding="5,3" Click="ChordPreset_Click" HorizontalAlignment="Stretch"/>
                                                <Button Grid.Column="7" Content="Add9" Margin="2" Padding="5,3" Click="ChordPreset_Click" HorizontalAlignment="Stretch"/>
                                                <Button Grid.Column="8" Content="6" Margin="2" Padding="5,3" Click="ChordPreset_Click" HorizontalAlignment="Stretch"/>
                                                <Button Grid.Column="9" Content="m6" Margin="2" Padding="5,3" Click="ChordPreset_Click" HorizontalAlignment="Stretch"/>
                                            </Grid>
                                        </GroupBox>
                                    </Grid>
                                </GroupBox>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>
            
            <!-- Arpeggio Mode Mapping Tab -->
            <TabItem Header="Arp" x:Name="ArpeggioMappingTab">
                <Grid>
                    <TextBlock Text="Arpeggio Mode settings coming soon" 
                             FontWeight="Bold" HorizontalAlignment="Center"/>
                </Grid>
            </TabItem>
            
            <!-- Direct Mode Mapping Tab -->
            <TabItem Header="Multi" x:Name="DirectMappingTab">
                <Grid>
                    <TextBlock Text="Direct mode mapping controls" 
                             FontWeight="Bold" HorizontalAlignment="Center"/>
                </Grid>
            </TabItem>
            
            <!-- Separator Tab -->
            <TabItem IsEnabled="False">
                <TabItem.Header>
                    <Separator Width="20" Background="Transparent"/>
                </TabItem.Header>
            </TabItem>
            
            <!-- Debug Tabs with better naming -->
            <TabItem>
                <TabItem.Header>
                    <TextBlock Text="Controller Visualizer" Foreground="#007ACC"/>
                </TabItem.Header>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Header section with controller status indicator (replacing mode indicator) -->
                    <Border Grid.Row="0" Background="#F5F5F5" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="15">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <!-- Title and description -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Xbox Controller Visualization" FontSize="20" FontWeight="SemiBold" Foreground="#333333"/>
                                <TextBlock Text="Real-time visualization of controller inputs and button states" 
                                         Foreground="#666666" Margin="0,5,0,0"/>
                            </StackPanel>
                            
                            <!-- Controller Status indicator (replacing mode indicator) -->
                            <Border Grid.Column="1" Background="#F0F0F0" BorderBrush="#DDDDDD" BorderThickness="1"
                                   CornerRadius="4" Padding="12,8" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="ControllerStatusIndicator" Width="10" Height="10" 
                                            Fill="LimeGreen" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="ControllerStatusText" Text="Connected" 
                                             FontWeight="SemiBold" Foreground="#555555" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                    
                    <!-- Main content area with 1/3 - 2/3 split -->
                    <Grid Grid.Row="1" Margin="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*"/> <!-- Left column: 1/3 -->
                            <ColumnDefinition Width="2*"/> <!-- Right column: 2/3 -->
                        </Grid.ColumnDefinitions>
                        
                        <!-- Left column - Debug Log only (removed Controller Status section) -->
                        <Grid Grid.Column="0" Margin="0,0,10,0">
                            <!-- Debug Log -->
                            <GroupBox Header="Input Activity Log">
                                <DockPanel Margin="10">
                                    <Button DockPanel.Dock="Top" Content="Clear Log" Click="ClearLog_Click" 
                                          HorizontalAlignment="Left" Margin="0,0,0,10" Padding="8,3"/>
                                    <Border DockPanel.Dock="Bottom" Background="#F0F0F0" BorderBrush="#E0E0E0" 
                                           BorderThickness="1" CornerRadius="4" Padding="10,6" Margin="0,10,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Last Input: " Foreground="#666666"/>
                                            <TextBlock x:Name="LastControllerInputText" Text="None" Foreground="#333333" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Border>
                                    <ListBox x:Name="VisualizerActivityLog" KeyDown="InputLog_KeyDown"/>
                                </DockPanel>
                            </GroupBox>
                        </Grid>
                        
                        <!-- Right column - Controller Visualizer -->
                        <Border Grid.Column="1" Background="White" BorderBrush="#E0E0E0" BorderThickness="1" 
                               CornerRadius="8" Padding="15" Margin="0,0,0,0">
                            <!-- Controller visualizer - larger now and takes full space -->
                            <Grid>
                                <!-- Large controller visualizer with shadow effect -->
                                <Border>
                                    <Border.Effect>
                                        <DropShadowEffect ShadowDepth="3" BlurRadius="8" Opacity="0.3" Color="#666666"/>
                                    </Border.Effect>
                                    <views:ControllerVisualizer x:Name="DebugVisualizer" MinHeight="500"/>
                                </Border>
                                
                                <!-- Button press overlay - visualizes last pressed button -->
                                <Border x:Name="LastPressedButtonOverlay" Background="#80333333" 
                                       Visibility="Collapsed" CornerRadius="4" MaxWidth="120" MaxHeight="40"
                                       HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                       Margin="0,0,10,10" Padding="10,5">
                                    <TextBlock x:Name="LastPressedButtonText" Text="A" 
                                              FontSize="18" FontWeight="Bold" Foreground="White" 
                                              HorizontalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>
            
            <TabItem>
                <TabItem.Header>
                    <TextBlock Text="Controller Simulator" Foreground="#007ACC"/>
                </TabItem.Header>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Header section with mode indicator -->
                    <Border Grid.Row="0" Background="#F5F5F5" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="15">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <!-- Title and description -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Xbox Controller Simulator" FontSize="20" FontWeight="SemiBold" Foreground="#333333"/>
                                <TextBlock Text="Interactive controller for testing MIDI mappings" 
                                         Foreground="#666666" Margin="0,5,0,0"/>
                            </StackPanel>
                            
                            <!-- Mode display with visual indicator -->
                            <Border Grid.Column="1" Background="#FFE1F0E5" BorderBrush="#81D4FA" BorderThickness="1" 
                                   CornerRadius="4" Padding="12,8" VerticalAlignment="Center">
                                <TextBlock Text="Interactive Mode" FontWeight="SemiBold" 
                                         Foreground="#0277BD"/>
                            </Border>
                        </Grid>
                    </Border>
                    
                    <!-- Main content area with controller - RESTRUCTURED -->
                    <Grid Grid.Row="1" Margin="20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="3*"/>
                            <RowDefinition Height="1*"/>
                        </Grid.RowDefinitions>
                        
                        <!-- Controller visualizer - ENLARGED AND CENTERED -->
                        <Border Grid.Row="0" Background="White" BorderBrush="#E0E0E0" BorderThickness="1" 
                               CornerRadius="8" Padding="10" Margin="0,0,0,10">
                            <Grid VerticalAlignment="Center">
                                <!-- Interactive controller with shadow effect -->
                                <Border>
                                    <Border.Effect>
                                        <DropShadowEffect ShadowDepth="3" BlurRadius="8" Opacity="0.3" Color="#666666"/>
                                    </Border.Effect>
                                    <!-- Simplified controller usage -->
                                    <views:InteractiveControllerVisualizer x:Name="TestVisualizer" 
                                                                         Height="450"
                                                                         HorizontalAlignment="Center"
                                                                         Background="Transparent"/>
                                </Border>
                            </Grid>
                        </Border>
                        
                        <!-- Bottom section: Settings and Test Results side by side - COMPACT -->
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <!-- Simulator Settings (left column) - More compact -->
                            <GroupBox Grid.Column="0" Header="Simulator Settings" Margin="0,0,5,0">
                                <Grid Margin="8,3">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="40"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <!-- Spring-back rate -->
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Spring-back:" 
                                              VerticalAlignment="Center" Margin="0,5,5,5"/>
                                    <Slider Grid.Row="0" Grid.Column="1" x:Name="SpringBackRateSlider" 
                                           Minimum="0.001" Maximum="0.1" Value="0.05"
                                           TickFrequency="0.01" TickPlacement="BottomRight" 
                                           IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                           ValueChanged="SpringBackRateSlider_ValueChanged"/>
                                    <TextBlock Grid.Row="0" Grid.Column="2" 
                                              Text="{Binding Value, ElementName=SpringBackRateSlider, StringFormat={}{0:F3}}" 
                                              VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                    
                                    <!-- Trigger rate -->
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Trigger rate:" 
                                              VerticalAlignment="Center" Margin="0,10,5,5"/>
                                    <Slider Grid.Row="1" Grid.Column="1" x:Name="TriggerRateSlider" 
                                           Minimum="1" Maximum="20" Value="10"
                                           TickFrequency="1" TickPlacement="BottomRight" 
                                           IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                           ValueChanged="TriggerRateSlider_ValueChanged"/>
                                    <TextBlock Grid.Row="1" Grid.Column="2" 
                                              Text="{Binding Value, ElementName=TriggerRateSlider, StringFormat={}{0:F0}}" 
                                              VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                </Grid>
                            </GroupBox>
                            
                            <!-- Test Results Log (right column) -->
                            <GroupBox Grid.Column="1" Header="Test Results" Margin="5,0,0,0">
                                <ListBox x:Name="TestResultsLog" Margin="5"/>
                            </GroupBox>
                        </Grid>
                    </Grid>
                </Grid>
            </TabItem>
            
            <TabItem>
                <TabItem.Header>
                    <TextBlock Text="Debug Log" Foreground="#007ACC"/>
                </TabItem.Header>
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <StackPanel Grid.Row="0" Orientation="Horizontal">
                        <Button Content="Clear Log" Click="ClearLog_Click" Margin="0,0,10,0"/>
                    </StackPanel>
                    
                    <ListBox x:Name="InputLog" Grid.Row="1" Margin="0,10,0,0" 
                            KeyDown="InputLog_KeyDown"/>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>