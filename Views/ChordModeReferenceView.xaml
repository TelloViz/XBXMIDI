<UserControl x:Class="XB2Midi.Views.ChordModeReferenceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:XB2Midi.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <GroupBox Header="Chord Mode Controls Reference" Margin="0,5">
        <Grid Margin="5">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Chord type reference (left column) -->
            <GroupBox Grid.Row="0"
                      Grid.Column="0"
                      Header="Chord Types"
                      Margin="3"
                      BorderBrush="#FFAAAAAA">
                <Grid Margin="3">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0"
                               Grid.Column="0"
                               Text="No Bumpers:"
                               Margin="5"
                               FontWeight="Bold"/>
                    <TextBlock Grid.Row="0"
                               Grid.Column="1"
                               Text="Root Note Only"
                               Margin="5"/>

                    <TextBlock Grid.Row="1"
                               Grid.Column="0"
                               Text="Left Bumper (LB):"
                               Margin="5"
                               FontWeight="Bold"/>
                    <TextBlock Grid.Row="1"
                               Grid.Column="1"
                               Text="Minor Triad (1-b3-5)"
                               Margin="5"/>

                    <TextBlock Grid.Row="2"
                               Grid.Column="0"
                               Text="Right Bumper (RB):"
                               Margin="5"
                               FontWeight="Bold"/>
                    <TextBlock Grid.Row="2"
                               Grid.Column="1"
                               Text="Major Triad (1-3-5)"
                               Margin="5"/>

                    <TextBlock Grid.Row="3"
                               Grid.Column="0"
                               Text="Double-Tap LB:"
                               Margin="5"
                               FontWeight="Bold"/>
                    <TextBlock Grid.Row="3"
                               Grid.Column="1"
                               Text="Minor 7th Chord (1-b3-5-b7)"
                               Margin="5"/>

                    <TextBlock Grid.Row="4"
                               Grid.Column="0"
                               Text="Double-Tap RB:"
                               Margin="5"
                               FontWeight="Bold"/>
                    <TextBlock Grid.Row="4"
                               Grid.Column="1"
                               Text="Major 7th Chord (1-3-5-7)"
                               Margin="5"/>

                    <TextBlock Grid.Row="5"
                               Grid.Column="0"
                               Text="Triple-Tap LB:"
                               Margin="5"
                               FontWeight="Bold"/>
                    <TextBlock Grid.Row="5"
                               Grid.Column="1"
                               Text="Minor 9th Chord (1-b3-5-b7-9)"
                               Margin="5"/>

                    <TextBlock Grid.Row="6"
                               Grid.Column="0"
                               Text="Triple-Tap RB:"
                               Margin="5"
                               FontWeight="Bold"/>
                    <TextBlock Grid.Row="6"
                               Grid.Column="1"
                               Text="Major 9th Chord (1-3-5-7-9)"
                               Margin="5"/>

                    <TextBlock Grid.Row="7"
                               Grid.Column="0"
                               Text="Both Bumpers:"
                               Margin="5"
                               FontWeight="Bold"/>
                    <TextBlock Grid.Row="7"
                               Grid.Column="1"
                               Text="Diminished Triad (1-b3-b5)"
                               Margin="5"/>
                </Grid>
            </GroupBox>

            <!-- Modifiers reference (right column) -->
            <GroupBox Grid.Row="0"
                      Grid.Column="1"
                      Header="Modifiers"
                      Margin="3"
                      BorderBrush="#FFAAAAAA">
                <Grid Margin="3">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0"
                               Grid.Column="0"
                               Text="Left Trigger:"
                               Margin="5"
                               FontWeight="Bold"/>
                    <TextBlock Grid.Row="0"
                               Grid.Column="1"
                               Text="Control velocity (pressure-sensitive)"
                               Margin="5"/>

                    <TextBlock Grid.Row="1"
                               Grid.Column="0"
                               Text="Right Trigger:"
                               Margin="5"
                               FontWeight="Bold"/>
                    <TextBlock Grid.Row="1"
                               Grid.Column="1"
                               Text="Sustain notes when buttons are released"
                               Margin="5"/>

                    <TextBlock Grid.Row="2"
                               Grid.Column="0"
                               Text="Left Joystick:"
                               Margin="5"
                               FontWeight="Bold"
                               VerticalAlignment="Top"/>
                    <StackPanel Grid.Row="2"
                                Grid.Column="1"
                                Margin="5">
                        <TextBlock Text="Change chord inversions:"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="• Center: Root position"
                                   Margin="10,2,0,0"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="• Up: 1st inversion"
                                   Margin="10,2,0,0"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="• Right: 2nd inversion"
                                   Margin="10,2,0,0"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="• Down: 3rd inversion (7th chords)"
                                   Margin="10,2,0,0"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="• Left: 4th inversion (9th chords)"
                                   Margin="10,2,0,0"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </GroupBox>

            <!-- Root note buttons (spanning both columns) -->
            <GroupBox Grid.Row="1"
                      Grid.Column="0"
                      Grid.ColumnSpan="2"
                      Header="Root Note Buttons"
                      Margin="3"
                      BorderBrush="#FFAAAAAA">
                <Grid Margin="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="Face Buttons:"
                               Margin="5"
                               FontWeight="Bold"/>
                    <TextBlock Grid.Column="1"
                               Text="A, B, X, Y select respective root notes"
                               Margin="5"/>

                    <TextBlock Grid.Column="2"
                               Text="D-Pad:"
                               Margin="5"
                               FontWeight="Bold"/>
                    <TextBlock Grid.Column="3"
                               Text="Up, Right, Down, Left select respective root notes"
                               Margin="5"/>
                </Grid>
            </GroupBox>
        </Grid>
    </GroupBox>
</UserControl>